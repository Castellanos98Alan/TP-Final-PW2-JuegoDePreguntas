<style>
    .derrota-page {
        min-height: calc(100vh - 140px);
        background:
                radial-gradient(circle at top left, rgba(255, 90, 90, 0.10), transparent 30%),
                radial-gradient(circle at bottom right, rgba(212, 170, 50, 0.08), transparent 35%),
                linear-gradient(180deg, #10294d 0%, #08192f 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        box-sizing: border-box;
        color: white;
    }

    .derrota-card {
        width: 100%;
        max-width: 920px;
        background:
                linear-gradient(
                        180deg,
                        rgba(17, 48, 89, 0.98),
                        rgba(6, 20, 40, 0.98)
                );
        border: 2px solid #d4af37;
        border-radius: 26px;
        padding: 42px 34px;
        text-align: center;
        box-shadow: 0 22px 55px rgba(0, 0, 0, 0.35);
        position: relative;
        overflow: hidden;
    }

    .derrota-icono {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        margin: 0 auto 20px auto;
        display: grid;
        place-items: center;
        background: rgba(174, 45, 45, 0.2);
        border: 2px solid #e06b6b;
        color: #ff8c8c;
        font-size: 40px;
        font-weight: bold;
    }

    .derrota-titulo {
        margin: 0;
        font-size: clamp(32px, 5vw, 48px);
        color: white;
        font-weight: 900;
    }

    .derrota-subtitulo {
        margin-top: 12px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 17px;
    }

    .pregunta-fallada {
        margin-top: 26px;
        background: rgba(4, 16, 33, 0.50);
        border: 1px solid rgba(212, 175, 55, 0.30);
        border-radius: 18px;
        padding: 24px;
    }

    .pregunta-fallada-label {
        display: block;
        color: rgba(255, 255, 255, 0.58);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 12px;
        margin-bottom: 10px;
        font-weight: 700;
    }

    .pregunta-fallada-texto {
        font-size: 24px;
        font-weight: 800;
        line-height: 1.4;
        margin: 0;
    }

    .resultado-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-top: 28px;
    }

    .resultado-box {
        background: rgba(4, 16, 33, 0.55);
        border: 1px solid rgba(212, 175, 55, 0.45);
        border-radius: 18px;
        padding: 22px;
    }

    .resultado-label {
        display: block;
        color: rgba(255, 255, 255, 0.58);
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 12px;
        margin-bottom: 8px;
        font-weight: 700;
    }

    .resultado-valor {
        display: block;
        font-size: 30px;
        font-weight: 900;
        color: #f4c34a;
    }

    .respuestas-lista {
        margin-top: 28px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .respuesta-card {
        background: rgba(4, 16, 33, 0.60);
        border: 2px solid rgba(255, 255, 255, 0.10);
        border-radius: 18px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        text-align: left;
    }

    .respuesta-card-correcta {
        border-color: #46d27c;
        background: rgba(28, 117, 57, 0.20);
    }

    .respuesta-card-incorrecta {
        border-color: #ee6666;
        background: rgba(156, 32, 32, 0.20);
    }

    .respuesta-letra {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 900;
        font-size: 18px;
        flex-shrink: 0;
        background: #d4af37;
        color: #07162d;
    }

    .respuesta-card-correcta .respuesta-letra {
        background: #46d27c;
        color: #062918;
    }

    .respuesta-card-incorrecta .respuesta-letra {
        background: #ee6666;
        color: #3b0909;
    }

    .respuesta-contenido {
        flex: 1;
    }

    .respuesta-texto {
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
    }

    .respuesta-estado {
        margin-top: 6px;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .respuesta-card-correcta .respuesta-estado {
        color: #8ee0a9;
    }

    .respuesta-card-incorrecta .respuesta-estado {
        color: #ff9f9f;
    }

    .mensaje-final {
        margin-top: 28px;
        color: rgba(255, 255, 255, 0.72);
        line-height: 1.6;
        font-size: 15px;
    }

    .acciones-derrota {
        margin-top: 32px;
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
    }

    .btn-derrota {
        min-width: 180px;
        padding: 14px 22px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 800;
        transition: 0.2s ease;
        display: inline-block;
    }

    .btn-jugar {
        background: linear-gradient(135deg, #d4af37, #f0cd6c);
        color: #07162d;
        border: 2px solid #d4af37;
    }

    .btn-jugar:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(212, 175, 55, 0.18);
    }

    .btn-lobby {
        background: transparent;
        border: 2px solid rgba(255, 255, 255, 0.25);
        color: white;
    }

    .btn-lobby:hover {
        border-color: #d4af37;
        color: #f4c34a;
        transform: translateY(-2px);
    }

    @media (max-width: 750px) {
        .derrota-card {
            padding: 32px 20px;
        }

        .resultado-grid,
        .respuestas-lista {
            grid-template-columns: 1fr;
        }

        .btn-derrota {
            width: 100%;
            box-sizing: border-box;
        }

        .pregunta-fallada-texto {
            font-size: 20px;
        }
    }
</style>

<div class="derrota-page">
    <div class="derrota-card">

        <div class="derrota-icono">✕</div>

        <h1 class="derrota-titulo">
            Partida perdida
        </h1>

        <p class="derrota-subtitulo">
            Elegiste una respuesta incorrecta y la partida terminó.
        </p>

        <div class="pregunta-fallada">
            <span class="pregunta-fallada-label">
                Pregunta en la que fallaste
            </span>

            <p class="pregunta-fallada-texto">
                {{enunciadoPregunta}}
            </p>
        </div>

        <div class="resultado-grid">

            <div class="resultado-box">
                <span class="resultado-label">
                    Respuestas correctas
                </span>
                <span class="resultado-valor">
                    {{respuestasCorrectas}}
                </span>
            </div>

            <div class="resultado-box">
                <span class="resultado-label">
                    Puntaje final
                </span>
                <span class="resultado-valor">
                    {{puntajeFinal}}
                </span>
            </div>

        </div>

        <div class="respuestas-lista">

            {{#respuestas}}
                <div class="respuesta-card
                    {{#esCorrecta}} respuesta-card-correcta{{/esCorrecta}}
                    {{#esIncorrecta}} respuesta-card-incorrecta{{/esIncorrecta}}">

                    <div class="respuesta-letra">
                        {{letra}}
                    </div>

                    <div class="respuesta-contenido">
                        <div class="respuesta-texto">
                            {{texto}}
                        </div>

                        {{#esCorrecta}}
                            <div class="respuesta-estado">
                                Respuesta correcta
                            </div>
                        {{/esCorrecta}}

                        {{#esIncorrecta}}
                            <div class="respuesta-estado">
                                Tu respuesta
                            </div>
                        {{/esIncorrecta}}
                    </div>

                </div>
            {{/respuestas}}

        </div>

        <p class="mensaje-final">
            Llegaste a responder correctamente
            <strong>{{respuestasCorrectas}}</strong>
            preguntas, pero al equivocarte perdiste los puntos acumulados
            en esta partida.
        </p>

        <div class="acciones-derrota">

            <a
                    href="?controller=partida&method=seleccionar"
                    class="btn-derrota btn-jugar"
            >
                Jugar otra vez
            </a>

            <a
                    href="?controller=lobby&method=index"
                    class="btn-derrota btn-lobby"
            >
                Volver al lobby
            </a>

        </div>

    </div>
</div>