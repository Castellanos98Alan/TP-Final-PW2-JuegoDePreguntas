<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte de Administrador</title>
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            color: #1a202c;
            margin: 15px 20px;
            font-size: 10px;
            line-height: 1.3;
        }
        .header {
            text-align: center;
            border-bottom: 2px solid #d4a72c;
            padding-bottom: 6px;
            margin-bottom: 10px;
        }
        .header h1 {
            margin: 0;
            color: #0d234a;
            font-size: 17px;
            letter-spacing: 0.5px;
        }
        .header p {
            margin: 2px 0 0;
            color: #64748b;
            font-size: 10px;
        }
        .metrics-grid {
            width: 100%;
            margin-bottom: 10px;
            border-collapse: collapse;
        }
        .metrics-grid td {
            width: 33.33%;
            padding: 3px;
            vertical-align: top;
        }
        .metric-card {
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 6px 4px;
            background: #f8fafc;
            text-align: center;
        }
        .metric-title {
            font-size: 8.5px;
            color: #64748b;
            text-transform: uppercase;
            font-weight: bold;
        }
        .metric-value {
            font-size: 15px;
            font-weight: bold;
            color: #0d234a;
            margin-top: 2px;
        }
        .section-title {
            font-size: 10.5px;
            font-weight: bold;
            color: #0d234a;
            border-bottom: 1px solid #cbd5e1;
            padding-bottom: 2px;
            margin-top: 10px;
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .charts-row {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
        }
        .charts-row td {
            width: 33.33%;
            vertical-align: top;
            padding: 0 4px;
            text-align: center;
        }
        .chart-box {
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            padding: 6px 4px;
            background: #ffffff;
            text-align: center;
        }
        .chart-box h4 {
            margin: 0 0 4px;
            font-size: 9px;
            color: #0d234a;
            text-transform: uppercase;
        }
        .chart-img {
            max-width: 100%;
            height: 110px;
        }
        table.data-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 8px;
        }
        table.data-table th, table.data-table td {
            border: 1px solid #cbd5e1;
            padding: 4px 5px;
            text-align: left;
            font-size: 9.5px;
        }
        table.data-table th {
            background-color: #f1f5f9;
            color: #334155;
            font-weight: bold;
        }
        .badge {
            display: inline-block;
            padding: 2px 4px;
            border-radius: 3px;
            font-size: 8.5px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .badge-facil { background: #dcfce7; color: #166534; }
        .badge-media { background: #fef9c3; color: #854d0e; }
        .badge-dificil { background: #fee2e2; color: #991b1b; }
        .page-break {
            page-break-before: always;
        }
        .footer {
            margin-top: 15px;
            text-align: center;
            font-size: 8.5px;
            color: #94a3b8;
            border-top: 1px solid #e2e8f0;
            padding-top: 4px;
        }
    </style>
</head>
<body>

    <!-- ==================== PÁGINA 1: MÉTRICAS Y GRÁFICOS ==================== -->

    <div class="header">
        <h1>Reporte Estadistico del Juego</h1>
        <p>Periodo analizado: <strong>{{periodo}}</strong></p>
    </div>

    <!-- METRICAS GENERALES -->
    <table class="metrics-grid">
        <tr>
            <td>
                <div class="metric-card">
                    <div class="metric-title">Partidas Jugadas</div>
                    <div class="metric-value">{{total_partidas}}</div>
                </div>
            </td>
            <td>
                <div class="metric-card">
                    <div class="metric-title">Usuarios Nuevos</div>
                    <div class="metric-value">{{usuarios_nuevos}}</div>
                </div>
            </td>
            <td>
                <div class="metric-card">
                    <div class="metric-title">Preguntas Creadas</div>
                    <div class="metric-value">{{preguntas_creadas}}</div>
                </div>
            </td>
        </tr>
        <tr>
            <td>
                <div class="metric-card">
                    <div class="metric-title">Preguntas Activas</div>
                    <div class="metric-value">{{preguntas_activas}}</div>
                </div>
            </td>
            <td>
                <div class="metric-card">
                    <div class="metric-title">Reportes Pendientes</div>
                    <div class="metric-value">{{reportes_pendientes}}</div>
                </div>
            </td>
            <td>
                <div class="metric-card">
                    <div class="metric-title">% Aciertos Global</div>
                    <div class="metric-value">{{porcentaje_correctas}}%</div>
                </div>
            </td>
        </tr>
    </table>

    <!-- GRÁFICOS VISUALES -->
    <div class="section-title">Distribucion Demografica (Graficos)</div>
    <table class="charts-row">
        <tr>
            <td>
                <div class="chart-box">
                    <h4>Usuarios por Pais</h4>
                    {{#grafico_paises_url}}
                    <img src="{{grafico_paises_url}}" class="chart-img" alt="Grafico Paises">
                    {{/grafico_paises_url}}
                    {{^grafico_paises_url}}
                    <p style="color:#94a3b8; font-size:9px; padding:20px 0;">Sin datos</p>
                    {{/grafico_paises_url}}
                </div>
            </td>
            <td>
                <div class="chart-box">
                    <h4>Usuarios por Sexo</h4>
                    {{#grafico_sexos_url}}
                    <img src="{{grafico_sexos_url}}" class="chart-img" alt="Grafico Sexos">
                    {{/grafico_sexos_url}}
                    {{^grafico_sexos_url}}
                    <p style="color:#94a3b8; font-size:9px; padding:20px 0;">Sin datos</p>
                    {{/grafico_sexos_url}}
                </div>
            </td>
            <td>
                <div class="chart-box">
                    <h4>Grupo de Edad</h4>
                    {{#grafico_edades_url}}
                    <img src="{{grafico_edades_url}}" class="chart-img" alt="Grafico Edades">
                    {{/grafico_edades_url}}
                    {{^grafico_edades_url}}
                    <p style="color:#94a3b8; font-size:9px; padding:20px 0;">Sin datos</p>
                    {{/grafico_edades_url}}
                </div>
            </td>
        </tr>
    </table>

    <div class="footer">
        Pagina 1 de 2 - Documento generado automaticamente - Sistema Preguntados Anime
    </div>

    <!-- ==================== PÁGINA 2: TABLA DE PREGUNTAS (EXACTAMENTE 10) ==================== -->
    <div class="page-break"></div>

    <div class="header">
        <h1>Balance y Dificultad de Preguntas</h1>
        <p>Mostrando las 10 preguntas del listado actual</p>
    </div>

    <table class="data-table">
        <thead>
            <tr>
                <th style="width: 38%;">Pregunta</th>
                <th>Anime</th>
                <th>Categoria</th>
                <th style="text-align: center;">Jugada</th>
                <th style="text-align: center;">Acertada</th>
                <th style="text-align: center;">% Exito</th>
                <th style="text-align: center;">Dificultad</th>
            </tr>
        </thead>
        <tbody>
            {{#preguntas}}
            <tr>
                <td>{{descripcion}}</td>
                <td>{{anime}}</td>
                <td>{{categoria}}</td>
                <td style="text-align: center;">{{veces_mostrada}}</td>
                <td style="text-align: center;">{{veces_acertada}}</td>
                <td style="text-align: center; font-weight: bold;">{{porcentaje_aciertos}}%</td>
                <td style="text-align: center;">
                    <span class="badge badge-{{dificultad}}">{{dificultad}}</span>
                </td>
            </tr>
            {{/preguntas}}
            {{^preguntas}}
            <tr>
                <td colspan="7" style="text-align: center; color: #94a3b8;">No se encontraron preguntas en este periodo</td>
            </tr>
            {{/preguntas}}
        </tbody>
    </table>

    <div class="footer">
        Pagina 2 de 2 - Documento generado automaticamente - Sistema Preguntados Anime
    </div>

</body>
</html>
