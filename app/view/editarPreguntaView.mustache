
<style>
    * {
        box-sizing: border-box;
    }

    .edit-container {
        width: 90%;
        max-width: 780px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .edit-title {
        margin: 0 0 25px;
        color: #F1CD73;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .edit-container label {
        display: block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #A9C2E8;
        letter-spacing: 0.5px;
    }

    .input-field {
        width: 100%;
        padding: 11px 14px;
        background: rgba(10, 26, 51, 0.85);
        border: 1px solid #315B91;
        border-radius: 8px;
        color: #FFFFFF;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
    }

    .input-field:focus {
        border-color: #D4AF55;
    }

    .input-field option {
        background: #0A1A33;
        color: #FFFFFF;
    }

    .options-section-title {
        margin: 22px 0 12px;
        font-size: 12px;
        font-weight: 600;
        color: #F1CD73;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .option-radio {
        accent-color: #F1CD73;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .actions-bar {
        margin-top: 28px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .btn-save {
        padding: 10px 22px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-save:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .btn-cancel {
        color: #A9C2E8;
        font-size: 13px;
        text-decoration: none;
        transition: color 0.2s;
    }

    .btn-cancel:hover {
        color: #F1CD73;
    }

    .warning-box {
        padding: 12px 16px;
        border: 1px solid #FF9800;
        border-radius: 8px;
        background: rgba(239, 108, 0, 0.15);
        color: #FFE082;
        font-size: 12px;
        margin-bottom: 14px;
    }

    @media (max-width: 600px) {
        .edit-container {
            width: 96%;
            padding: 24px 18px;
        }

        .actions-bar {
            flex-wrap: wrap;
        }
    }
</style>

<div class="edit-container">

    <h1 class="edit-title">EDITAR PREGUNTA #{{id}}</h1>

    <form action="editor/guardarEdicion" method="POST">

        <input type="hidden" name="id" value="{{id}}">

        <!-- ENUNCIADO -->
        <div class="form-group">
            <label for="descripcion">Enunciado:</label>

            <input
                type="text"
                id="descripcion"
                name="descripcion"
                class="input-field"
                value="{{descripcion}}"
                maxlength="500"
                required
            >
        </div>

        <!-- ANIME -->
        <div class="form-group">
            <label for="anime_id">Anime:</label>

            <select name="anime_id" id="anime_id" class="input-field" required>
                {{#animes}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>
                        {{nombre}}
                    </option>
                {{/animes}}
            </select>
        </div>

        <!-- CATEGORÍA -->
        <div class="form-group">
            <label for="categoria_id">Categoría:</label>

            <select name="categoria_id" id="categoria_id" class="input-field" required>
                {{#categorias}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>
                        {{nombre}}
                    </option>
                {{/categorias}}
            </select>
        </div>

        <!-- DIFICULTAD -->
        <div class="form-group">
            <label for="dificultad">Dificultad:</label>

            <select name="dificultad" id="dificultad" class="input-field" required>
                {{#dificultades}}
                    <option value="{{valor}}" {{#selected}}selected{{/selected}}>
                        {{nombre}}
                    </option>
                {{/dificultades}}
            </select>
        </div>

        <!-- RESPUESTAS -->
        <div class="options-section-title">
            Opciones de respuesta (Marcá con el radio cuál es la correcta):
        </div>

        {{#tiene_opciones}}
            {{#opciones}}
                <div class="option-row">

                    <input
                        type="radio"
                        name="correcta"
                        value="{{id}}"
                        class="option-radio"
                        {{checked}}
                        required
                    >

                    <input
                        type="text"
                        name="opciones[{{id}}]"
                        class="input-field"
                        value="{{descripcion}}"
                        maxlength="255"
                        required
                    >

                </div>
            {{/opciones}}
        {{/tiene_opciones}}

        {{^tiene_opciones}}
            <div class="warning-box">
                Esta pregunta no tiene sus cuatro respuestas disponibles.
                Volvé al panel y verificá los datos antes de intentar editarla.
            </div>
        {{/tiene_opciones}}

        <!-- BOTONES -->
        <div class="actions-bar">

            {{#tiene_opciones}}
                <button type="submit" class="btn-save">
                    GUARDAR CAMBIOS
                </button>
            {{/tiene_opciones}}

            <a href="editor" class="btn-cancel">
                Cancelar y volver
            </a>

        </div>

    </form>
</div>
