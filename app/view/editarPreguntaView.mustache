
<style>
    * {
        box-sizing: border-box;
    }

    .edit-container {
        width: 90%;
        max-width: 780px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }



    .edit-title {
        overflow-wrap: anywhere;
        margin: 0 0 25px;
        color: #F1CD73;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .edit-container label {
        display: block;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 600;
        color: #A9C2E8;
        letter-spacing: 0.5px;
    }

    .input-field {
        width: 100%;
        padding: 11px 14px;
        background: rgba(10, 26, 51, 0.85);
        border: 1px solid #315B91;
        border-radius: 8px;
        color: #FFFFFF;
        font-size: 13px;
        outline: none;
        transition: border-color 0.2s;
    }

    .input-field:focus {
        border-color: #D4AF55;
    }

    .input-field option {
        background: #0A1A33;
        color: #FFFFFF;
    }

    .options-section-title {
        margin: 22px 0 12px;
        font-size: 12px;
        font-weight: 600;
        color: #F1CD73;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .option-radio {
        accent-color: #F1CD73;
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        cursor: pointer;
    }

    .actions-bar {
        margin-top: 28px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .btn-save {
        padding: 10px 22px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-save:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .btn-cancel {
        color: #A9C2E8;
        font-size: 13px;
        text-decoration: none;
        transition: color 0.2s;
    }

    .btn-cancel:hover {
        color: #F1CD73;
    }

    .warning-box {
        padding: 12px 16px;
        border: 1px solid #FF9800;
        border-radius: 8px;
        background: rgba(239, 108, 0, 0.15);
        color: #FFE082;
        font-size: 12px;
        margin-bottom: 14px;
    }

    /* radio + texto de cada opción: el input puede encogerse en pantallas angostas */
    .option-row .input-field {
        flex: 1;
        min-width: 0;
    }

    @media (max-width: 600px) {
        .edit-container {
            width: 100%;
            margin: 16px auto 30px;
            padding: 20px 14px;
            border-radius: 14px;
        }

        .edit-title {
            font-size: 20px;
        }

        .option-row {
            gap: 10px;
        }

        .option-radio {
            width: 22px;
            height: 22px;
        }

        /* botones a todo el ancho, fáciles de tocar */
        .actions-bar {
            flex-direction: column;
            align-items: stretch;
            gap: 12px;
        }

        .btn-save {
            width: 100%;
            padding: 14px;
            font-size: 13px;
        }

        .btn-cancel {
            padding: 10px;
            text-align: center;
        }

        .pregunta-imagen-container,
        .pregunta-audio-container {
            padding: 12px;
        }

        .reportes-revision {
            padding: 14px;
        }

        .acciones-revision {
            flex-direction: column;
        }

        .acciones-revision form,
        .acciones-revision button {
            width: 100%;
        }
    }

    .pregunta-imagen-container,
    .pregunta-audio-container {
        margin: 20px 0;
        padding: 15px;
        background: rgba(10, 26, 51, 0.85);
        border: 1px solid #315B91;
        border-radius: 10px;
    }

    .pregunta-imagen {
        display: block;
        max-width: 300px;
        max-height: 250px;
        width: 100%;
        object-fit: contain;
        margin: 12px auto;
        border-radius: 8px;
    }

    .pregunta-audio-container audio {
        width: 100%;
        margin-top: 12px;
    }

    .reportes-revision {
        background: #132c4e;
        border: 1px solid #b98b3b;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .reportes-revision h3 {
        color: #f1cd73;
        margin-bottom: 12px;
    }

    .reportes-revision h4 {
        color: #a9c2e8;
        margin: 20px 0 12px;
    }

    .reporte-item {
        background: #0a1a33;
        padding: 12px 15px;
        border-left: 3px solid #fbbf24;
        border-radius: 6px;
        margin-bottom: 10px;
    }

    .reporte-item strong {
        color: #fbbf24;
    }

    .reporte-item p {
        color: #e5edff;
        margin: 8px 0;
        overflow-wrap: anywhere;
    }

    .reporte-item small {
        color: #88a5cd;
    }

    .acciones-revision {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .acciones-revision button {
        padding: 12px 18px;
        border: none;
        border-radius: 8px;
        color: white;
        font-weight: bold;
        cursor: pointer;
        transition: 0.2s ease;
    }

    .btn-aprobar-revision {
        background: #168653;
    }

    .btn-mantener-baja {
        background: #a43832;
    }

    .acciones-revision button:hover {
        transform: translateY(-2px);
        filter: brightness(1.15);
    }
</style>

<div class="edit-container">

    <h1 class="edit-title">EDITAR PREGUNTA #{{id}}</h1>

    {{#esBajaPorReportes}}

        <div class="reportes-revision">

            <h3>Pregunta dada de baja por reportes</h3>

            <p>
                Esta pregunta recibió
                <strong>{{cantidadReportes}} reportes pendientes</strong>
                y fue desactivada automáticamente.
            </p>

            <h4>Motivos y comentarios</h4>

            {{#reportes}}
                <div class="reporte-item">
                    <strong>{{motivo}}</strong>

                    <p>{{descripcion}}</p>

                    <small>{{created_at}}</small>
                </div>
            {{/reportes}}

        </div>

    {{/esBajaPorReportes}}

    <form action="editor/guardarEdicion" method="POST">

        <input type="hidden" name="id" value="{{id}}">

        <!-- ENUNCIADO -->
        <div class="form-group">
            <label for="descripcion">Enunciado:</label>

            <input
                    type="text"
                    id="descripcion"
                    name="descripcion"
                    class="input-field"
                    value="{{descripcion}}"
                    maxlength="500"
                    required
            >
        </div>

        <!-- ANIME -->
        <div class="form-group">
            <label for="anime_id">Anime:</label>

            <select name="anime_id" id="anime_id" class="input-field" required>
                {{#animes}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>
                        {{nombre}}
                    </option>
                {{/animes}}
            </select>
        </div>

        <!-- CATEGORÍA -->
        <div class="form-group">
            <label for="categoria_id">Categoría:</label>

            <select name="categoria_id" id="categoria_id" class="input-field" required>
                {{#categorias}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>
                        {{nombre}}
                    </option>
                {{/categorias}}
            </select>
        </div>

        <!-- DIFICULTAD -->
        <div class="form-group">
            <label for="dificultad">Dificultad:</label>

            <select name="dificultad" id="dificultad" class="input-field" required>
                {{#dificultades}}
                    <option value="{{valor}}" {{#selected}}selected{{/selected}}>
                        {{nombre}}
                    </option>
                {{/dificultades}}
            </select>
        </div>

        {{#esImagen}}
            <div class="pregunta-imagen-container">
                <label>Imagen de la pregunta:</label>

                <img src="{{recursoUrl}}"
                     alt="Imagen de la pregunta"
                     class="pregunta-imagen">
            </div>
        {{/esImagen}}

        {{#esAudio}}
            <div class="pregunta-audio-container">
                <label>Audio de la pregunta:</label>

                <audio controls preload="metadata">
                    <source src="{{recursoUrl}}" type="audio/mpeg">
                    Tu navegador no soporta audio.
                </audio>
            </div>
        {{/esAudio}}

        <!-- RESPUESTAS -->
        <div class="options-section-title">
            Opciones de respuesta (Marcá con el radio cuál es la correcta):
        </div>

        {{#tiene_opciones}}
            {{#opciones}}
                <div class="option-row">

                    <input
                            type="radio"
                            name="correcta"
                            value="{{id}}"
                            class="option-radio"
                        {{checked}}
                            required
                    >

                    <input
                            type="text"
                            name="opciones[{{id}}]"
                            class="input-field"
                            value="{{descripcion}}"
                            maxlength="255"
                            required
                    >

                </div>
            {{/opciones}}
        {{/tiene_opciones}}

        {{^tiene_opciones}}
            <div class="warning-box">
                Esta pregunta no tiene sus cuatro respuestas disponibles.
                Volvé al panel y verificá los datos antes de intentar editarla.
            </div>
        {{/tiene_opciones}}

        <!-- BOTONES -->
        <div class="actions-bar">

            {{#tiene_opciones}}
                <button type="submit" class="btn-save">
                    GUARDAR CAMBIOS
                </button>
            {{/tiene_opciones}}

            <a href="editor" class="btn-cancel">
                Cancelar y volver
            </a>

        </div>



    </form>

    {{#esBajaPorReportes}}

        <div class="acciones-revision">

            <form action="editor/revisarPreguntaReportada" method="POST">
                <input type="hidden" name="id_pregunta" value="{{id}}">
                <input type="hidden" name="accion" value="aprobar">

                <button type="submit" class="btn-aprobar-revision">
                    Aprobar y reactivar
                </button>
            </form>

            <form action="editor/revisarPreguntaReportada" method="POST">
                <input type="hidden" name="id_pregunta" value="{{id}}">
                <input type="hidden" name="accion" value="mantener_baja">

                <button type="submit" class="btn-mantener-baja">
                    Mantener dada de baja
                </button>
            </form>

        </div>

    {{/esBajaPorReportes}}
</div>
