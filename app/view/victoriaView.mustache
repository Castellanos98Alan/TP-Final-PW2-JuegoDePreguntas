<style>
    * {
        box-sizing: border-box;
    }

    .victoria-page {
        min-height: calc(100vh - 140px);
        background:
                radial-gradient(circle at top left, rgba(244, 195, 74, 0.12), transparent 30%),
                radial-gradient(circle at bottom right, rgba(70, 210, 124, 0.10), transparent 35%),
                linear-gradient(180deg, #10294d 0%, #08192f 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        color: white;
    }

    .victoria-card {
        width: 100%;
        max-width: 820px;
        background: linear-gradient(
                180deg,
                rgba(17, 48, 89, 0.98),
                rgba(6, 20, 40, 0.98)
        );
        border: 2px solid #d4af37;
        border-radius: 28px;
        padding: 46px 36px;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        position: relative;
        overflow: hidden;
    }

    .victoria-card::before,
    .victoria-card::after {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border: 1px solid rgba(244, 195, 74, 0.16);
        border-radius: 50%;
        pointer-events: none;
    }

    .victoria-card::before {
        top: -120px;
        left: -90px;
    }

    .victoria-card::after {
        bottom: -120px;
        right: -90px;
    }

    .victoria-icono {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        margin: 0 auto 22px auto;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #d4af37, #f4d66f);
        color: #07162d;
        font-size: 46px;
        border: 3px solid #ffe69a;
        box-shadow: 0 0 35px rgba(244, 195, 74, 0.28);
    }

    .victoria-titulo {
        margin: 0;
        font-size: clamp(32px, 6vw, 54px);
        font-weight: 900;
        color: white;
    }

    .victoria-subtitulo {
        margin: 12px 0 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 18px;
    }

    .premio-principal {
        margin-top: 30px;
        background: linear-gradient(
                135deg,
                rgba(212, 175, 55, 0.18),
                rgba(244, 195, 74, 0.05)
        );
        border: 2px solid #d4af37;
        border-radius: 22px;
        padding: 28px;
    }

    .premio-label {
        display: block;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 10px;
    }

    .premio-valor {
        display: block;
        color: #f4c34a;
        font-size: 58px;
        line-height: 1;
        font-weight: 900;
    }

    .premio-texto {
        display: block;
        margin-top: 8px;
        color: rgba(255, 255, 255, 0.70);
        font-size: 15px;
    }

    .estadisticas-victoria {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-top: 22px;
    }

    .estadistica-card {
        background: rgba(4, 16, 33, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 18px;
        padding: 20px 14px;
    }

    .estadistica-label {
        color: rgba(255, 255, 255, 0.58);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: block;
        margin-bottom: 8px;
    }

    .estadistica-valor {
        color: #8ee0a9;
        font-size: 30px;
        font-weight: 900;
    }

    .mensaje-victoria {
        margin: 26px auto 0 auto;
        max-width: 600px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 16px;
        line-height: 1.6;
    }

    .mensaje-victoria strong {
        color: #f4c34a;
    }

    .acciones-victoria {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
        position: relative;
        z-index: 2;
    }

    .btn-victoria {
        min-width: 190px;
        padding: 14px 24px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 800;
        transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                border-color 0.2s ease;
        display: inline-block;
    }

    .btn-jugar-victoria {
        background: linear-gradient(135deg, #d4af37, #f0cd6c);
        color: #07162d;
        border: 2px solid #d4af37;
    }

    .btn-jugar-victoria:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(212, 175, 55, 0.22);
    }

    .btn-lobby-victoria {
        background: transparent;
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.25);
    }

    .btn-lobby-victoria:hover {
        transform: translateY(-2px);
        border-color: #d4af37;
        color: #f4c34a;
    }

    @media (max-width: 650px) {
        .victoria-page {
            padding: 18px 12px 28px;
        }

        .victoria-card {
            padding: 26px 18px;
            border-radius: 20px;
        }

        .victoria-icono {
            width: 72px;
            height: 72px;
            font-size: 34px;
            margin-bottom: 14px;
        }

        .victoria-subtitulo {
            font-size: 14.5px;
            margin-top: 8px;
        }

        .premio-principal {
            margin-top: 20px;
            padding: 20px 14px;
            border-radius: 16px;
        }

        .premio-valor {
            font-size: 44px;
        }

        .estadisticas-victoria {
            gap: 10px;
            margin-top: 16px;
        }

        .estadistica-card {
            padding: 14px 10px;
            border-radius: 14px;
        }

        .estadistica-label {
            font-size: 10.5px;
            margin-bottom: 4px;
        }

        .estadistica-valor {
            font-size: 22px;
        }

        .mensaje-victoria {
            margin-top: 18px;
            font-size: 14px;
        }

        .acciones-victoria {
            margin-top: 22px;
            gap: 10px;
        }

        .btn-victoria {
            width: 100%;
            min-width: 0;
            padding: 13px 18px;
        }
    }

    /*One piece animacion*/


    .corte-zoro {
        position: fixed;
        inset: 0;
        z-index: 99999;
        pointer-events: none;
        overflow: hidden;
    }

    .mitad-superior,
    .mitad-inferior {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #10294d, #020617);
    }

    .mitad-superior {
        clip-path: polygon(0 0, 100% 0, 100% 15%, 0 85%);
        animation: corteSuperior 0.9s 0.5s forwards;
    }

    .mitad-inferior {
        clip-path: polygon(0 85%, 100% 15%, 100% 100%, 0 100%);
        animation: corteInferior 0.9s 0.5s forwards;
    }

    .corte-espada {
        position: absolute;
        inset: 0;
        background: #b9ffdc;
        opacity: 0;
        filter: drop-shadow(0 0 20px #00ff88);
        animation: espada 0.7s forwards;
    }

    @keyframes corteSuperior {
        to {
            transform: translate(-12%, -110%) rotate(-8deg);
        }
    }

    @keyframes corteInferior {
        to {
            transform: translate(12%, 110%) rotate(8deg);
        }
    }

    @keyframes espada {
        0% {
            opacity: 1;
            clip-path: polygon(0 84%, 0 84%, 0 86%, 0 86%);
        }

        60% {
            opacity: 1;
            clip-path: polygon(0 84%, 100% 14%, 100% 16%, 0 86%);
        }

        100% {
            opacity: 0;
            clip-path: polygon(0 84%, 100% 14%, 100% 16%, 0 86%);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .corte-zoro {
            display: none;
        }
    }

    .animacion-naruto {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: #0a172c;
        overflow: hidden;
        pointer-events: none;
        animation: revelarVictoria 0.6s 1.5s forwards;
    }
    .kunai {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 150px;
        height: 50px;
        opacity: 0;
        filter: drop-shadow(0 4px 5px #000);
        animation: lanzarKunai 0.5s var(--delay) both;
    }

    .kunai::before {
        content: "";
        position: absolute;
        inset: 0;

        background: linear-gradient(
                0deg,
                #64748b 49%,
                #d5dde7 50%
        );

        clip-path: polygon(
                100% 50%,
                55% 0,
                39% 36%,
                13% 36%,
                13% 64%,
                39% 64%,
                55% 100%
        );
    }

    .kunai::after {
        content: "";
        position: absolute;
        left: 0;
        top: 14px;
        width: 16px;
        height: 16px;
        border: 5px solid #aab6c2;
        border-radius: 50%;
    }

    .kunai-1 {
        --x: -65vw;
        --y: -50vh;
        --giro: 30deg;
        --fx: -120px;
        --fy: -60px;
        --delay: 0s;
    }

    .kunai-2 {
        --x: 65vw;
        --y: -50vh;
        --giro: 150deg;
        --fx: 120px;
        --fy: -60px;
        --delay: 0.12s;
    }

    .kunai-3 {
        --x: -65vw;
        --y: 50vh;
        --giro: -30deg;
        --fx: -120px;
        --fy: 60px;
        --delay: 0.22s;
    }

    .kunai-4 {
        --x: 65vw;
        --y: 50vh;
        --giro: 210deg;
        --fx: 120px;
        --fy: 60px;
        --delay: 0.32s;
    }

    .kunai-5 {
        --x: 0px;
        --y: -65vh;
        --giro: 90deg;
        --fx: 0px;
        --fy: -100px;
        --delay: 0.4s;
    }

    .kunai-6 {
        --x: 0px;
        --y: 65vh;
        --giro: -90deg;
        --fx: 0px;
        --fy: 100px;
        --delay: 0.48s;
    }

    @keyframes lanzarKunai {
        0% {
            opacity: 1;
            transform:
                    translate(-50%, -50%)
                    translate(var(--x), var(--y))
                    rotate(var(--giro));
        }

        100% {
            opacity: 1;
            transform:
                    translate(-50%, -50%)
                    translate(var(--fx), var(--fy))
                    rotate(var(--giro));
        }
    }

    .humo-ninja {
        position: absolute;
        inset: -20%;
        opacity: 0;

        background:
                radial-gradient(circle at 40% 45%,
                #ffffff 0%, #aab4bf 16%, transparent 34%),
                radial-gradient(circle at 60% 55%,
                #ffffff 0%, #bbc3cd 22%, transparent 40%),
                radial-gradient(ellipse,
                #d9e1e8 10%, transparent 65%);

        animation: explosionHumo 1s 1s both;
    }

    @keyframes explosionHumo {
        0% {
            opacity: 0;
            transform: scale(0.1);
        }

        45% {
            opacity: 1;
            transform: scale(1.8);
        }

        100% {
            opacity: 0;
            transform: scale(3);
        }
    }

    @keyframes revelarVictoria {
        to {
            opacity: 0;
            visibility: hidden;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animacion-naruto {
            display: none;
        }
    }

    /*animacion de dragon ball*/

    .animacion-dragonball {
        position: fixed;
        inset: 0;
        z-index: 99999;
        background: #030b1b;
        overflow: hidden;
        pointer-events: none;

        animation:
                temblorDragonBall 0.13s 1.4s 6,
                revelarDragonBall 0.5s 2.5s forwards;
    }

    /* Aura de energía */

    .aura-ki {
        position: absolute;
        inset: -50%;

        background: repeating-conic-gradient(
                from 0deg at 32.5% 50%,
                transparent 0deg 15deg,
                #339dff80 16deg 18deg,
                transparent 19deg 30deg
        );

        opacity: 0;
        animation: cargarAura 1.45s both;
    }

    /* Esfera de energía */

    .energia-ki {
        position: absolute;
        left: 15%;
        top: 50%;
        width: 150px;
        height: 150px;
        border-radius: 50%;

        background: radial-gradient(
                circle,
                white 20%,
                #dcfcff 40%,
                #22baff 65%,
                #006fff 80%
        );

        box-shadow:
                0 0 25px white,
                0 0 60px #00aaff,
                0 0 100px #007bff;

        opacity: 0;
        animation: cargarKi 1.45s both;
    }

    /* Rayo del Kamehameha */

    .kamehameha {
        position: absolute;
        top: 50%;
        left: 15%;
        width: 110%;
        height: 200px;
        transform-origin: left center;

        background: linear-gradient(
                0deg,
                transparent,
                #005aff 10%,
                #00baff 22%,
                #bdf6ff 35%,
                white 46%,
                white 54%,
                #bdf6ff 65%,
                #00baff 78%,
                #005aff 90%,
                transparent
        );

        filter: drop-shadow(0 0 30px #00bfff);
        opacity: 0;

        animation: lanzarKamehameha 1s 1.4s both;
    }

    /* Onda expansiva */

    .onda-expansiva {
        position: absolute;
        left: 20%;
        top: 50%;
        width: 150px;
        height: 150px;
        border: 6px solid #aefaff;
        border-radius: 50%;
        box-shadow: 0 0 25px #009dff;
        opacity: 0;

        animation: expandirOnda 0.9s 1.45s both;
    }

    /* Destello final */

    .destello-dragonball {
        position: absolute;
        inset: 0;
        background: #d8f8ff;
        opacity: 0;

        animation: destelloFinal 0.8s 2s both;
    }

    /* Texto del ataque */

    .texto-kamehameha {
        position: absolute;
        top: 14%;
        width: 100%;
        text-align: center;
        font-size: clamp(25px, 6vw, 70px);
        font-weight: 900;
        letter-spacing: 3px;
        color: white;
        text-shadow: 0 0 20px #00bfff;
        opacity: 0;

        animation: mostrarKamehameha 1.1s 1.3s both;
    }

    @keyframes cargarAura {
        0%, 100% { opacity: 0; }
        50%, 90% { opacity: 0.7; }
    }

    @keyframes cargarKi {
        0% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.05);
        }

        20% {
            opacity: 1;
        }

        45% {
            transform: translate(-50%, -50%) scale(0.65);
        }

        60% {
            transform: translate(-50%, -50%) scale(0.5);
        }

        90% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.15);
        }

        100% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(1.5);
        }
    }

    @keyframes lanzarKamehameha {
        0% {
            opacity: 1;
            transform: translateY(-50%)
            scaleX(0.01) scaleY(0.2);
        }

        25%, 70% {
            opacity: 1;
            transform: translateY(-50%)
            scaleX(1) scaleY(1.3);
        }

        100% {
            opacity: 0;
            transform: translateY(-50%)
            scaleX(1) scaleY(2.8);
        }
    }

    @keyframes expandirOnda {
        0% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(0.2);
        }

        100% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(9);
        }
    }

    @keyframes temblorDragonBall {
        25% {
            transform: translate(-4px, 3px);
        }

        75% {
            transform: translate(4px, -3px);
        }
    }

    @keyframes destelloFinal {
        0%, 100% { opacity: 0; }
        40% { opacity: 0.95; }
    }

    @keyframes mostrarKamehameha {
        0%, 100% { opacity: 0; }
        20%, 75% { opacity: 1; }
    }

    @keyframes revelarDragonBall {
        to {
            opacity: 0;
            visibility: hidden;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animacion-dragonball {
            display: none;
        }
    }

