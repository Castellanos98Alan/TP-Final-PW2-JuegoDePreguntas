<style>
    * {
        box-sizing: border-box;
    }

    .victoria-page {
        min-height: calc(100vh - 140px);
        background:
                radial-gradient(circle at top left, rgba(244, 195, 74, 0.12), transparent 30%),
                radial-gradient(circle at bottom right, rgba(70, 210, 124, 0.10), transparent 35%),
                linear-gradient(180deg, #10294d 0%, #08192f 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        color: white;
    }

    .victoria-card {
        width: 100%;
        max-width: 820px;
        background: linear-gradient(
                180deg,
                rgba(17, 48, 89, 0.98),
                rgba(6, 20, 40, 0.98)
        );
        border: 2px solid #d4af37;
        border-radius: 28px;
        padding: 46px 36px;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        position: relative;
        overflow: hidden;
    }

    .victoria-card::before,
    .victoria-card::after {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        border: 1px solid rgba(244, 195, 74, 0.16);
        border-radius: 50%;
        pointer-events: none;
    }

    .victoria-card::before {
        top: -120px;
        left: -90px;
    }

    .victoria-card::after {
        bottom: -120px;
        right: -90px;
    }

    .victoria-icono {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        margin: 0 auto 22px auto;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #d4af37, #f4d66f);
        color: #07162d;
        font-size: 46px;
        border: 3px solid #ffe69a;
        box-shadow: 0 0 35px rgba(244, 195, 74, 0.28);
    }

    .victoria-titulo {
        margin: 0;
        font-size: clamp(32px, 6vw, 54px);
        font-weight: 900;
        color: white;
    }

    .victoria-subtitulo {
        margin: 12px 0 0;
        color: rgba(255, 255, 255, 0.75);
        font-size: 18px;
    }

    .premio-principal {
        margin-top: 30px;
        background: linear-gradient(
                135deg,
                rgba(212, 175, 55, 0.18),
                rgba(244, 195, 74, 0.05)
        );
        border: 2px solid #d4af37;
        border-radius: 22px;
        padding: 28px;
    }

    .premio-label {
        display: block;
        color: rgba(255, 255, 255, 0.65);
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        margin-bottom: 10px;
    }

    .premio-valor {
        display: block;
        color: #f4c34a;
        font-size: 58px;
        line-height: 1;
        font-weight: 900;
    }

    .premio-texto {
        display: block;
        margin-top: 8px;
        color: rgba(255, 255, 255, 0.70);
        font-size: 15px;
    }

    .estadisticas-victoria {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-top: 22px;
    }

    .estadistica-card {
        background: rgba(4, 16, 33, 0.58);
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 18px;
        padding: 20px 14px;
    }

    .estadistica-label {
        color: rgba(255, 255, 255, 0.58);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: block;
        margin-bottom: 8px;
    }

    .estadistica-valor {
        color: #8ee0a9;
        font-size: 30px;
        font-weight: 900;
    }

    .mensaje-victoria {
        margin: 26px auto 0 auto;
        max-width: 600px;
        color: rgba(255, 255, 255, 0.72);
        font-size: 16px;
        line-height: 1.6;
    }

    .mensaje-victoria strong {
        color: #f4c34a;
    }

    .acciones-victoria {
        margin-top: 30px;
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 14px;
        position: relative;
        z-index: 2;
    }

    .btn-victoria {
        min-width: 190px;
        padding: 14px 24px;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 800;
        transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                border-color 0.2s ease;
        display: inline-block;
    }

    .btn-jugar-victoria {
        background: linear-gradient(135deg, #d4af37, #f0cd6c);
        color: #07162d;
        border: 2px solid #d4af37;
    }

    .btn-jugar-victoria:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(212, 175, 55, 0.22);
    }

    .btn-lobby-victoria {
        background: transparent;
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.25);
    }

    .btn-lobby-victoria:hover {
        transform: translateY(-2px);
        border-color: #d4af37;
        color: #f4c34a;
    }

    @media (max-width: 650px) {
        .victoria-page {
            padding: 18px 12px 28px;
        }

        .victoria-card {
            padding: 26px 18px;
            border-radius: 20px;
        }

        .victoria-icono {
            width: 72px;
            height: 72px;
            font-size: 34px;
            margin-bottom: 14px;
        }

        .victoria-subtitulo {
            font-size: 14.5px;
            margin-top: 8px;
        }

        .premio-principal {
            margin-top: 20px;
            padding: 20px 14px;
            border-radius: 16px;
        }

        .premio-valor {
            font-size: 44px;
        }

        .estadisticas-victoria {
            gap: 10px;
            margin-top: 16px;
        }

        .estadistica-card {
            padding: 14px 10px;
            border-radius: 14px;
        }

        .estadistica-label {
            font-size: 10.5px;
            margin-bottom: 4px;
        }

        .estadistica-valor {
            font-size: 22px;
        }

        .mensaje-victoria {
            margin-top: 18px;
            font-size: 14px;
        }

        .acciones-victoria {
            margin-top: 22px;
            gap: 10px;
        }

        .btn-victoria {
            width: 100%;
            min-width: 0;
            padding: 13px 18px;
        }
    }
</style>

<div class="victoria-page">

    <div class="victoria-card">

        <div class="victoria-icono">
            🏆
        </div>

        <h1 class="victoria-titulo">
            ¡Ganaste!
        </h1>

        <p class="victoria-subtitulo">
            Completaste las 15 preguntas de la partida.
        </p>

        <div class="premio-principal">
            <span class="premio-label">
                Puntaje obtenido
            </span>

            <span class="premio-valor">
                {{puntaje}}
            </span>

            <span class="premio-texto">
                puntos
            </span>
        </div>

        <div class="estadisticas-victoria">
            <div class="estadistica-card">
                <span class="estadistica-label">
                    Preguntas superadas
                </span>

                <span class="estadistica-valor">
                    15 / 15
                </span>
            </div>

            <div class="estadistica-card">
                <span class="estadistica-label">
                    Resultado
                </span>

                <span class="estadistica-valor">
                    Victoria
                </span>
            </div>
        </div>

        <p class="mensaje-victoria">
            Superaste las preguntas
            <strong>fáciles, medias y difíciles</strong>
            sin cometer ningún error.
        </p>

        <div class="acciones-victoria">
            <a href="partida/seleccionar" class="btn-victoria btn-jugar-victoria">
                Jugar otra vez
            </a>

            <a href="lobby" class="btn-victoria btn-lobby-victoria">
                Volver al lobby
            </a>
        </div>

    </div>

</div>