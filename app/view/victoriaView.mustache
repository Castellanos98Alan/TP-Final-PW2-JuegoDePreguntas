    /* Animacion de pokemon al ganar*/

    .animacion-pokemon {
        position: fixed;
        inset: 0;
        z-index: 99999;
        overflow: hidden;
        pointer-events: none;

        background: radial-gradient(
                ellipse, #19375c, #060e20
        );

        animation: revelarPokemon 0.65s 3s forwards;
    }

    .pokeball {
        position: absolute;
        width: 180px;
        height: 180px;
        left: 50%;
        top: 50%;

        transform: translate(-50%, -50%);

        filter: drop-shadow(0 10px 15px #0008);

        animation:
                entradaPokeball 0.7s both,
                moverPokeball 0.45s 0.8s 3;
    }

    .pokeball-superior,
    .pokeball-inferior {
        position: absolute;
        width: 100%;
        height: 50%;
        box-sizing: border-box;
        border: 6px solid #161b22;
    }

    /* Mitad roja */

    .pokeball-superior {
        top: 0;
        border-radius: 100px 100px 0 0;

        background: radial-gradient(
                circle at 28% 22%,
                #ff9292,
                #ef2929 45%,
                #a80c0c
        );

        transform-origin: 50% 100%;

        animation: abrirPokeball 0.45s 2.15s forwards;
    }

    /* Mitad blanca */

    .pokeball-inferior {
        bottom: 0;
        border-radius: 0 0 100px 100px;
        background: linear-gradient(white, #bac9dd);
    }

    /* Botón central */

    .pokeball-boton {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 45px;
        height: 45px;

        transform: translate(-50%, -50%);

        border: 7px solid #161b22;
        border-radius: 50%;
        background: white;

        box-shadow: inset 0 0 0 3px #b9c6d6;

        animation:
                iluminarBoton 0.45s 0.8s 3,
                ocultarBoton 0.3s 2.15s forwards;
    }

    .luz-pokeball {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 150px;
        height: 150px;
        border-radius: 50%;

        background: radial-gradient(
                circle,
                white 10%,
                #c4faff 35%,
                #3aa5ff 50%,
                transparent 73%
        );

        opacity: 0;
        animation: liberarLuz 0.9s 2.3s both;
    }

    .rayos-pokemon {
        position: absolute;
        inset: -50%;

        background: repeating-conic-gradient(
                from 0deg,
                transparent 0deg 19deg,
                #84ddff88 20deg 24deg,
                transparent 25deg 36deg
        );

        opacity: 0;
        animation: rayosPokemon 1s 2.3s both;
    }

    .estrellas-pokemon {
        position: absolute;
        left: 50%;
        top: 50%;
    }

    .estrellas-pokemon span {
        position: absolute;
        color: #ffdc48;
        font-size: 40px;
        text-shadow: 0 0 15px #ffb900;

        opacity: 0;
        animation: lanzarEstrellas 0.9s 2.35s both;
    }

    @keyframes entradaPokeball {
        0% {
            transform: translate(-50%, -230%)
            rotate(-200deg);
            opacity: 0;
        }

        70% {
            transform: translate(-50%, -35%)
            rotate(15deg);
            opacity: 1;
        }

        100% {
            transform: translate(-50%, -50%)
            rotate(0deg);
        }
    }

    @keyframes moverPokeball {
        0%, 100% {
            transform: translate(-50%, -50%)
            rotate(0deg);
        }

        25% {
            transform: translate(-50%, -50%)
            rotate(-22deg);
        }

        75% {
            transform: translate(-50%, -50%)
            rotate(22deg);
        }
    }

    @keyframes abrirPokeball {
        to {
            transform: translateY(-45px)
            rotate(-25deg);
        }
    }

    @keyframes iluminarBoton {
        50% {
            background: #ff6464;
            box-shadow: 0 0 20px #ff3030;
        }
    }

    @keyframes ocultarBoton {
        to {
            opacity: 0;
        }
    }

    @keyframes liberarLuz {
        0% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(0.1);
        }

        45% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(4);
        }

        100% {
            opacity: 0;
            transform: translate(-50%, -50%) scale(12);
        }
    }

    @keyframes rayosPokemon {
        0%, 100% {
            opacity: 0;
        }

        45% {
            opacity: 1;
            transform: rotate(20deg);
        }
    }

    @keyframes lanzarEstrellas {
        0% {
            opacity: 0;
            transform: rotate(var(--angulo))
            translateX(0);
        }

        30% {
            opacity: 1;
        }

        100% {
            opacity: 0;
            transform: rotate(var(--angulo))
            translateX(250px)
            rotate(calc(-1 * var(--angulo)));
        }
    }

    @keyframes revelarPokemon {
        to {
            opacity: 0;
            visibility: hidden;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .animacion-pokemon {
            display: none;
        }
    }


</style>


