<style>

    body {
        background:
                linear-gradient(
                        rgba(2, 8, 25, 0.45),
                        rgba(2, 8, 25, 0.55)
                ),
                url("public/Fondo-Home2.png") !important;
        background-size: cover !important;
        background-position: center !important;
        background-repeat: no-repeat !important;
        background-attachment: fixed !important;
    }

    body::before {
        content: "";
        position: fixed;
        width: 700px;
        height: 700px;
        border-radius: 50%;
        border: 2px solid rgba(245, 200, 75, 0.10);
        top: -350px;
        left: 50%;
        transform: translateX(-50%);
        box-shadow:
                0 0 80px rgba(0, 89, 255, 0.20),
                inset 0 0 80px rgba(0, 89, 255, 0.08);
        pointer-events: none;
    }

    body::after {
        content: "";
        position: fixed;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        border: 1px solid rgba(245, 200, 75, 0.10);
        bottom: -250px;
        right: -120px;
        pointer-events: none;
    }

    .container {
        width: 100%;
        max-width: 1150px;
        margin: 10px auto 40px;
        position: relative;
        z-index: 2;
    }

    /* ===========================
       ESTADÍSTICAS RÁPIDAS
    =========================== */
    .estadisticas {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
    }

    .estadistica {
        background: linear-gradient(145deg, #06132e, #0b285f);
        border: 1px solid #d4a72c;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        box-shadow:
                inset 0 0 20px rgba(0,0,0,.35),
                0 0 10px rgba(35, 96, 255, 0.10);
        transition: 0.3s ease;
    }

    .estadistica:hover {
        transform: translateY(-4px);
        box-shadow: 0 0 18px rgba(245, 200, 75, 0.28);
    }

    .estadistica .icono {
        font-size: 25px;
        margin-bottom: 8px;
    }

    .estadistica strong {
        display: block;
        font-size: 28px;
        color: #f5c84b;
        margin-bottom: 5px;
    }

    .estadistica span {
        color: #c6d7f5;
        font-size: 14px;
    }

    /* ===========================
       ZONA DE JUEGO (3 COLUMNAS)
    =========================== */
    .zona-juego {
        display: grid;
        grid-template-columns: 1fr 1.05fr 1fr;
        gap: 20px;
        margin-top: 25px;
        align-items: stretch;
    }

    .panel {
        background: linear-gradient(
                160deg,
                rgba(3, 14, 38, .88),
                rgba(8, 31, 77, .88)
        );
        border: 1px solid #d4a72c;
        border-radius: 18px;
        padding: 22px;
        box-shadow:
                inset 0 0 25px rgba(0,0,0,.25),
                0 0 15px rgba(41, 89, 255, .08);
    }

    /* HISTORIAL */
    .historial h2 {
        color: #f5c84b;
        font-size: 21px;
        margin-bottom: 18px;
        border-bottom: 1px solid rgba(245, 200, 75, .25);
        padding-bottom: 12px;
    }

    .partida {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
        align-items: center;
        padding: 14px 4px;
        border-bottom: 1px solid rgba(255,255,255,.10);
    }

    .partida:last-child {
        border-bottom: none;
    }

    .partida-nombre {
        color: #f5c84b;
        font-weight: bold;
    }

    .partida-fecha {
        color: #a9bfdf;
        font-size: 13px;
        margin-top: 4px;
    }

    .partida-puntos {
        color: #f5c84b;
        font-weight: bold;
    }

    /* JUGAR */
    .jugar-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 315px;
        position: relative;
        overflow: hidden;
    }

    .jugar-container::before {
        content: "";
        position: absolute;
        width: 260px;
        height: 260px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(43, 103, 255, .45), transparent 65%);
        filter: blur(10px);
    }

    .jugar-container::after {
        content: "";
        position: absolute;
        width: 265px;
        height: 265px;
        border-radius: 50%;
        border: 2px solid rgba(245, 200, 75, 0.7);
        box-shadow:
                0 0 20px rgba(245, 200, 75, 0.7),
                0 0 50px rgba(0, 102, 255, 0.45);
        animation: pulso 2.5s infinite;
    }

    @keyframes pulso {
        0%, 100% {
            transform: scale(1);
            opacity: 0.7;
        }
        50% {
            transform: scale(1.06);
            opacity: 1;
        }
    }

    .btn-jugar {
        width: 230px;
        height: 230px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-decoration: none;
        color: #06132d;
        font-weight: 900;
        font-size: 26px;
        background: radial-gradient(circle at 35% 30%, #fff2ad, #f5c84b 40%, #b98211 100%);
        border: 6px double #fff0a4;
        box-shadow:
                0 0 15px #f5c84b,
                0 0 40px rgba(245, 200, 75, .45),
                inset 0 0 25px rgba(255,255,255,.5);
        transition: .3s;
        position: relative;
        z-index: 3;
    }

    .btn-jugar .icono {
        font-size: 40px;
        margin-bottom: 10px;
    }

    .btn-jugar:hover {
        transform: scale(1.07);
        box-shadow:
                0 0 25px #f5c84b,
                0 0 65px rgba(245, 200, 75, .65);
    }

    /* RANKING */
    .ranking {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 315px;
        text-align: center;
        transition: .3s;
        background:
                linear-gradient(rgba(3, 15, 41, 0.55), rgba(3, 15, 41, 0.55)),
                url("public/ranking-fondo.jpg");
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        box-shadow:
                inset 0 0 20px rgba(0,0,0,0.15),
                0 0 15px rgba(41, 89, 255, .10);
    }

    .ranking:hover {
        box-shadow: 0 0 25px rgba(245, 200, 75, .20);
    }

    .btn-ranking {
        color: white;
        text-decoration: none;
        font-size: 24px;
        font-weight: bold;
        padding: 14px 28px;
        border-radius: 12px;
        border: 1px solid #d4a72c;
        transition: .3s;
        background: rgba(3, 14, 38, .35);
        box-shadow: 0 0 12px rgba(245, 200, 75, 0.18);
    }

    .btn-ranking:hover {
        background: #d4a72c;
        color: #06132d;
    }

    /* ===========================
       CREAR PREGUNTA
    =========================== */
    .crear-pregunta {
        width: 100%;
        margin-top: 25px;
        display: flex;
        justify-content: center;
    }

    .btn-pregunta {
        width: 360px;
        padding: 16px;
        text-align: center;
        border: 1px solid #d4a72c;
        border-radius: 30px;
        color: white;
        font-size: 16px;
        font-weight: bold;
        text-decoration: none;
        background: linear-gradient(90deg, #06132e, #0d347c, #06132e);
        transition: .3s;
        box-shadow: 0 0 12px rgba(31, 89, 255, .15);
    }

    .btn-pregunta:hover {
        color: #06132d;
        background: linear-gradient(90deg, #b98211, #f5c84b, #b98211);
        box-shadow: 0 0 20px rgba(245, 200, 75, .45);
    }

    /* ===========================
       RESPONSIVE
    =========================== */
    @media (max-width: 900px) {
        .zona-juego {
            grid-template-columns: 1fr;
        }

        .estadisticas {
            grid-template-columns: 1fr;
        }

        .jugar-container {
            min-height: 290px;
        }

        .ranking {
            min-height: 240px;
        }
    }

    @media (max-width: 600px) {
        .btn-jugar {
            width: 200px;
            height: 200px;
            font-size: 22px;
        }

        .jugar-container::after {
            width: 230px;
            height: 230px;
        }

        .btn-pregunta {
            width: 100%;
        }
    }
</style>

<div class="container">

    <!-- 1. ESTADÍSTICAS DEL JUGADOR -->
    <section class="estadisticas">

        <div class="estadistica">
            <div class="icono">⭐</div>
            <strong>{{puntaje_acumulado}}</strong>
            <span>puntos acumulados</span>
        </div>

        <div class="estadistica">
            <div class="icono">🏆</div>
            <strong>#{{posicion}}</strong>
            <span>en el ranking</span>
        </div>

        <div class="estadistica">
            <div class="icono">📅</div>
            <strong>{{miembro_desde}}</strong>
            <span>miembro desde</span>
        </div>

    </section>

    <!-- 2. ZONA PRINCIPAL DE JUEGO -->
    <section class="zona-juego">

        <!-- HISTORIAL -->
        <div class="panel historial">
            <h2>📊 Últimas partidas</h2>

            {{#partidas}}
                <div class="partida">
                    <div>
                        <div class="partida-nombre">
                            Partida #{{id}}
                        </div>
                        <div class="partida-fecha">
                            {{fecha}}
                        </div>
                        <div>
                            {{resultado}}
                        </div>
                    </div>

                    <div class="partida-puntos">
                        {{puntaje}} pts
                    </div>
                </div>
            {{/partidas}}

            {{^partidas}}
                <div style="text-align:center; color:#a9bfdf; padding:40px 10px;">
                    Todavía no jugaste ninguna partida.
                </div>
            {{/partidas}}
        </div>

        <div class="panel jugar-container">
            <a href="?controller=partida&method=nueva" class="btn-jugar">
                <div class="icono">⚔</div>
                <div>Jugar</div>
                <div>partida</div>
                <div style="font-size:30px; margin-top:8px;">›</div>
            </a>
        </div>

        <div class="panel ranking">
            <a href="?controller=ranking&method=show" class="btn-ranking">
                Ver ranking
            </a>
        </div>

    </section>

    <div class="crear-pregunta">
        <a href="?controller=pregunta&method=crear" class="btn-pregunta">
            ❓ Crear pregunta &nbsp;&nbsp; ›
        </a>
    </div>

</div>