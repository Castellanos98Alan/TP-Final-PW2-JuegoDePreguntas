<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Preguntados Anime Edition</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: white;

            background:
                    radial-gradient(circle at 50% 25%, rgba(0, 119, 255, 0.25), transparent 25%),
                    radial-gradient(circle at 15% 65%, rgba(89, 0, 255, 0.18), transparent 30%),
                    radial-gradient(circle at 85% 70%, rgba(0, 102, 255, 0.18), transparent 30%),
                    linear-gradient(180deg, #030914 0%, #081b49 50%, #050919 100%);

            background-attachment: fixed;
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;

            width: 700px;
            height: 700px;

            border-radius: 50%;

            border: 2px solid rgba(245, 200, 75, 0.10);

            top: -350px;
            left: 50%;
            transform: translateX(-50%);

            box-shadow:
                    0 0 80px rgba(0, 89, 255, 0.20),
                    inset 0 0 80px rgba(0, 89, 255, 0.08);

            pointer-events: none;
        }

        body::after {
            content: "";
            position: fixed;

            width: 500px;
            height: 500px;

            border-radius: 50%;

            border: 1px solid rgba(245, 200, 75, 0.10);

            bottom: -250px;
            right: -120px;

            pointer-events: none;
        }

        /* ===========================
           DECORACIONES LATERALES
        =========================== */

        .decoracion {
            position: fixed;

            width: 220px;
            height: 500px;

            top: 180px;

            opacity: 0.14;

            background-size: contain;
            background-repeat: no-repeat;
            background-position: center;

            pointer-events: none;

            z-index: 0;
        }

        .decoracion-izquierda {
            left: 0;

            background-image:
                    url("../assets/img/anime-left.png");
        }

        .decoracion-derecha {
            right: 0;

            background-image:
                    url("../assets/img/anime-right.png");
        }

        /* ===========================
           HEADER
        =========================== */

        .header {
            width: 100%;
            padding: 18px 40px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            background: rgba(3, 12, 35, 0.88);

            border-bottom: 1px solid #d4a72c;

            box-shadow:
                    0 4px 20px rgba(0,0,0,0.4),
                    0 0 30px rgba(34, 88, 255, 0.15);

            position: relative;
            z-index: 5;
        }

        .logo {
            color: #f5c84b;
            font-size: 26px;
            font-weight: 900;
            letter-spacing: 2px;
            text-shadow: 0 0 12px rgba(255, 200, 70, 0.45);
        }

        .logo span {
            display: block;
            color: white;
            font-size: 10px;
            letter-spacing: 5px;
            text-align: center;
        }

        .usuario-header {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .usuario-header strong {
            color: #f5c84b;
        }

        .btn-logout {
            text-decoration: none;
            color: white;

            padding: 11px 20px;

            border: 1px solid #d4a72c;
            border-radius: 10px;

            transition: 0.3s;

            background: rgba(7, 27, 67, 0.8);
        }

        .btn-logout:hover {
            background: #d4a72c;
            color: #051126;

            box-shadow: 0 0 15px #d4a72c;
        }

        /* ===========================
           CONTENEDOR
        =========================== */

        .container {
            width: 92%;
            max-width: 1150px;

            margin: 35px auto 60px;

            position: relative;
            z-index: 2;
        }

        /* ===========================
           PERFIL
        =========================== */

        .perfil {
            display: flex;
            align-items: center;
            gap: 30px;

            padding: 25px 30px;

            border: 2px solid #d4a72c;
            border-radius: 20px;

            background:
                    linear-gradient(
                            90deg,
                            rgba(3, 15, 41, 0.98) 0%,
                            rgba(6, 34, 92, 0.92) 55%,
                            rgba(4, 20, 55, 0.85) 100%
                    ),
                    url("public/");

            background-size: cover;
            background-position: center;

            box-shadow:
                    0 0 25px rgba(27, 104, 255, 0.15),
                    inset 0 0 25px rgba(0,0,0,0.3);

            position: relative;
            overflow: hidden;
        }

        .perfil::after {
            content: "";
            position: absolute;

            width: 350px;
            height: 350px;

            border: 1px solid rgba(245, 200, 75, 0.15);
            border-radius: 50%;

            right: -100px;
            top: -140px;
        }

        .foto-perfil {
            width: 120px;
            height: 120px;

            border-radius: 50%;

            border: 4px solid #f5c84b;

            object-fit: cover;

            box-shadow:
                    0 0 10px #f5c84b,
                    0 0 25px rgba(245, 200, 75, 0.35);

            position: relative;
            z-index: 2;
        }

        .perfil-info {
            position: relative;
            z-index: 2;
        }

        .perfil-info h1 {
            font-size: 32px;
            color: #f5c84b;
            margin-bottom: 6px;

            text-shadow: 0 0 10px rgba(245, 200, 75, 0.25);
        }

        .perfil-info .username {
            color: #b7d1ff;
            margin-bottom: 8px;
        }

        .perfil-info .ubicacion {
            color: #e6efff;
        }

        /* ===========================
           ESTADÍSTICAS
        =========================== */

        .estadisticas {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            gap: 18px;

            margin-top: 20px;
        }

        .estadistica {
            background:
                    linear-gradient(
                            145deg,
                            #06132e,
                            #0b285f
                    );

            border: 1px solid #d4a72c;
            border-radius: 16px;

            padding: 20px;

            text-align: center;

            box-shadow:
                    inset 0 0 20px rgba(0,0,0,.35),
                    0 0 10px rgba(35, 96, 255, 0.10);

            transition: 0.3s;
        }

        .estadistica:hover {
            transform: translateY(-4px);

            box-shadow:
                    0 0 18px rgba(245, 200, 75, 0.28);
        }

        .estadistica .icono {
            font-size: 25px;
            margin-bottom: 8px;
        }

        .estadistica strong {
            display: block;

            font-size: 28px;
            color: #f5c84b;

            margin-bottom: 5px;
        }

        .estadistica span {
            color: #c6d7f5;
            font-size: 14px;
        }

        /* ===========================
           ZONA PRINCIPAL
        =========================== */

        .zona-juego {
            display: grid;

            grid-template-columns:
                1fr 1.05fr 1fr;

            gap: 20px;

            margin-top: 25px;

            align-items: stretch;
        }

        .panel {
            background:
                    linear-gradient(
                            160deg,
                            rgba(3, 14, 38, .96),
                            rgba(8, 31, 77, .96)
                    );

            border: 1px solid #d4a72c;
            border-radius: 18px;

            padding: 22px;

            box-shadow:
                    inset 0 0 25px rgba(0,0,0,.3),
                    0 0 15px rgba(41, 89, 255, .08);
        }

        /* ===========================
           HISTORIAL
        =========================== */

        .historial h2 {
            color: #f5c84b;
            font-size: 21px;

            margin-bottom: 18px;

            border-bottom:
                    1px solid rgba(245, 200, 75, .25);

            padding-bottom: 12px;
        }

        .partida {
            display: grid;

            grid-template-columns:
                1fr auto;

            gap: 10px;

            align-items: center;

            padding: 14px 4px;

            border-bottom:
                    1px solid rgba(255,255,255,.10);
        }

        .partida:last-child {
            border-bottom: none;
        }

        .partida-nombre {
            color: #f5c84b;
            font-weight: bold;
        }

        .partida-fecha {
            color: #a9bfdf;
            font-size: 13px;
            margin-top: 4px;
        }

        .partida-puntos {
            color: #f5c84b;
            font-weight: bold;
        }

        .ganada {
            color: #48e597;
        }

        .perdida {
            color: #ff6464;
        }

        /* ===========================
           JUGAR
        =========================== */

        .jugar-container {
            display: flex;
            justify-content: center;
            align-items: center;

            min-height: 315px;

            position: relative;
            overflow: hidden;
        }

        .jugar-container::before {
            content: "";

            position: absolute;

            width: 260px;
            height: 260px;

            border-radius: 50%;

            background:
                    radial-gradient(
                            circle,
                            rgba(43, 103, 255, .45),
                            transparent 65%
                    );

            filter: blur(10px);
        }

        .jugar-container::after {
            content: "";

            position: absolute;

            width: 265px;
            height: 265px;

            border-radius: 50%;

            border: 2px solid rgba(245, 200, 75, 0.7);

            box-shadow:
                    0 0 20px rgba(245, 200, 75, 0.7),
                    0 0 50px rgba(0, 102, 255, 0.45);

            animation: pulso 2.5s infinite;
        }

        @keyframes pulso {

            0%, 100% {
                transform: scale(1);
                opacity: 0.7;
            }

            50% {
                transform: scale(1.06);
                opacity: 1;
            }

        }

        .btn-jugar {
            width: 230px;
            height: 230px;

            border-radius: 50%;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            text-decoration: none;

            color: #06132d;

            font-weight: 900;
            font-size: 26px;

            background:
                    radial-gradient(
                            circle at 35% 30%,
                            #fff2ad,
                            #f5c84b 40%,
                            #b98211 100%
                    );

            border: 6px double #fff0a4;

            box-shadow:
                    0 0 15px #f5c84b,
                    0 0 40px rgba(245, 200, 75, .45),
                    inset 0 0 25px rgba(255,255,255,.5);

            transition: .3s;

            position: relative;
            z-index: 3;
        }

        .btn-jugar .icono {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .btn-jugar:hover {
            transform: scale(1.07);

            box-shadow:
                    0 0 25px #f5c84b,
                    0 0 65px rgba(245, 200, 75, .65);
        }

        /* ===========================
           RANKING
        =========================== */

        .ranking {
            display: flex;

            flex-direction: column;
            justify-content: center;
            align-items: center;

            min-height: 315px;

            text-align: center;

            transition: .3s;

            background:
                    linear-gradient(
                            rgba(3, 15, 41, 0.88),
                            rgba(3, 15, 41, 0.88)
                    ),
                    url("../assets/img/ranking-bg.jpg");

            background-size: cover;
            background-position: center;
        }

        .ranking:hover {
            box-shadow:
                    0 0 25px rgba(245, 200, 75, .20);
        }

        .ranking-icon {
            font-size: 75px;
            margin-bottom: 20px;

            filter:
                    drop-shadow(0 0 8px #f5c84b);
        }

        .btn-ranking {
            color: white;
            text-decoration: none;

            font-size: 21px;
            font-weight: bold;

            padding: 12px 25px;

            border-radius: 10px;

            border: 1px solid #d4a72c;

            transition: .3s;

            background: rgba(3, 14, 38, .65);
        }

        .btn-ranking:hover {
            background: #d4a72c;
            color: #06132d;
        }

        /* ===========================
           CREAR PREGUNTA
        =========================== */

        .crear-pregunta {
            width: 100%;

            margin-top: 20px;

            display: flex;
            justify-content: center;
        }

        .btn-pregunta {
            width: 360px;

            padding: 16px;

            text-align: center;

            border: 1px solid #d4a72c;
            border-radius: 30px;

            color: white;

            font-size: 16px;
            font-weight: bold;

            text-decoration: none;

            background:
                    linear-gradient(
                            90deg,
                            #06132e,
                            #0d347c,
                            #06132e
                    );

            transition: .3s;

            box-shadow:
                    0 0 12px rgba(31, 89, 255, .15);
        }

        .btn-pregunta:hover {
            color: #06132d;

            background:
                    linear-gradient(
                            90deg,
                            #b98211,
                            #f5c84b,
                            #b98211
                    );

            box-shadow:
                    0 0 20px rgba(245, 200, 75, .45);
        }

        /* ===========================
           RESPONSIVE
        =========================== */

        @media (max-width: 1100px) {

            .decoracion {
                opacity: 0.08;
            }

        }

        @media (max-width: 900px) {

            .zona-juego {
                grid-template-columns: 1fr;
            }

            .estadisticas {
                grid-template-columns: 1fr;
            }

            .jugar-container {
                min-height: 290px;
            }

            .ranking {
                min-height: 240px;
            }

            .decoracion {
                display: none;
            }

        }

        @media (max-width: 600px) {

            .header {
                padding: 15px;

                flex-direction: column;
                gap: 15px;
            }

            .perfil {
                flex-direction: column;
                text-align: center;
            }

            .foto-perfil {
                width: 105px;
                height: 105px;
            }

            .perfil-info h1 {
                font-size: 25px;
            }

            .btn-jugar {
                width: 200px;
                height: 200px;

                font-size: 22px;
            }

            .jugar-container::after {
                width: 230px;
                height: 230px;
            }

            .btn-pregunta {
                width: 100%;
            }

        }

    </style>
</head>

<body>

<div class="decoracion decoracion-izquierda"></div>
<div class="decoracion decoracion-derecha"></div>


<header class="header">

    <div class="logo">
        ✦ PREGUNTADOS
        <span>ANIME EDITION</span>
    </div>

    <div class="usuario-header">

        <div>
            Hola,
            <strong>{{username}}</strong>
        </div>

        <a
                href="?controller=login&method=logout"
                class="btn-logout">
            Cerrar Sesión
        </a>

    </div>

</header>


<main class="container">

    <!-- PERFIL -->

    <section class="perfil">

        <img
                class="foto-perfil"
                src="{{foto_perfil}}"
                alt="Foto de perfil de {{username}}">

        <div class="perfil-info">

            <h1>{{nombre_completo}}</h1>

            <div class="username">
                @{{username}}
            </div>

            <div class="ubicacion">
                📍 {{ubicacion}}
            </div>

        </div>

    </section>


    <!-- ESTADÍSTICAS -->

    <section class="estadisticas">

        <div class="estadistica">

            <div class="icono">⭐</div>

            <strong>
                {{puntaje_acumulado}}
            </strong>

            <span>
                puntos acumulados
            </span>

        </div>


        <div class="estadistica">

            <div class="icono">🏆</div>

            <strong>
                #{{posicion}}
            </strong>

            <span>
                en el ranking
            </span>

        </div>


        <div class="estadistica">

            <div class="icono">📅</div>

            <strong>
                {{miembro_desde}}
            </strong>

            <span>
                miembro desde
            </span>

        </div>

    </section>


    <!-- ZONA DE JUEGO -->

    <section class="zona-juego">


        <!-- HISTORIAL -->

        <div class="panel historial">

            <h2>
                📊 Últimas partidas
            </h2>


            {{#partidas}}

                <div class="partida">

                    <div>

                        <div class="partida-nombre">
                            Partida #{{id}}
                        </div>

                        <div class="partida-fecha">
                            {{fecha}}
                        </div>

                        <div>
                            {{resultado}}
                        </div>

                    </div>


                    <div class="partida-puntos">
                        {{puntaje}} pts
                    </div>

                </div>

            {{/partidas}}


            {{^partidas}}

                <div style="
                    text-align:center;
                    color:#a9bfdf;
                    padding:30px 5px;
                ">

                    Todavía no jugaste ninguna partida.

                </div>

            {{/partidas}}

        </div>


        <!-- JUGAR -->

        <div class="panel jugar-container">

            <a
                    href="?controller=partida&method=nueva"
                    class="btn-jugar">

                <div class="icono">
                    ⚔
                </div>

                <div>
                    Jugar
                </div>

                <div>
                    partida
                </div>

                <div style="
                    font-size:30px;
                    margin-top:8px;
                ">
                    ›
                </div>

            </a>

        </div>


        <!-- RANKING -->

        <div class="panel ranking">

            <div class="ranking-icon">
                🏆
            </div>

            <a
                    href="?controller=ranking&method=show"
                    class="btn-ranking">

                Ver ranking ›

            </a>

        </div>

    </section>


    <!-- CREAR PREGUNTA -->

    <div class="crear-pregunta">

        <a
                href="?controller=pregunta&method=crear"
                class="btn-pregunta">

            ❓ Crear pregunta
            &nbsp;&nbsp; ›

        </a>

    </div>

</main>

</body>
</html>
```