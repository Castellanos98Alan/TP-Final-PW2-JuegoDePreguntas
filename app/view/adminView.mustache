<style>
    * {
        box-sizing: border-box;
    }

    .admin-container {
        width: 92%;
        max-width: 1200px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .admin-emblem {
        width: 54px;
        height: 54px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #D4AF55;
        border-radius: 50%;
        color: #F1CD73;
        font-size: 26px;
    }

    .admin-container h1 {
        margin: 0;
        text-align: center;
        color: #F1CD73;
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 700;
        letter-spacing: 1px;
    }

    .admin-subtitle {
        margin: 6px 0 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        color: #DCE6F8;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-align: center;
    }

    .admin-subtitle::before,
    .admin-subtitle::after {
        content: "";
        width: 32px;
        height: 1px;
        flex-shrink: 0;
        background: #D4AF55;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 25px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(185, 139, 59, 0.35);
    }

    .tag-user {
        color: #F1CD73;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .btn-gold {
        padding: 9px 18px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    /* Filtros */

    .filter-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 18px;
        margin-bottom: 28px;
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
    }

    .filter-container label {
        color: #F1CD73;
        font-size: 13px;
        font-weight: bold;
    }

    .filter-container select {
        min-width: 180px;
        padding: 10px 14px;
        border: 1px solid #D4AF55;
        border-radius: 7px;
        background: #102749;
        color: white;
        outline: none;
    }

    .filter-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .table-filters {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 14px;
        padding: 16px 18px;
        margin-bottom: 14px;
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
    }

    .table-filters .filtro-grupo {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    .table-filters label {
        color: #F1CD73;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .table-filters select {
        min-width: 170px;
        padding: 9px 12px;
        border: 1px solid #D4AF55;
        border-radius: 7px;
        background: #102749;
        color: white;
        outline: none;
    }

    .table-filters .contador-resultados {
        margin-left: auto;
        color: #A9C2E8;
        font-size: 12px;
    }

    th.ordenable {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    th.ordenable:hover {
        color: #FFFFFF;
    }

    th.ordenable .flecha {
        display: inline-block;
        width: 12px;
        margin-left: 4px;
        opacity: 0.45;
    }

    th.ordenable.activo .flecha {
        opacity: 1;
    }

    @media (max-width: 750px) {
        .admin-container {
            width: 96%;
            padding: 25px 15px;
        }

        .charts-grid {
            grid-template-columns: 1fr;
        }

        .header-bar {
            justify-content: center;
        }

        .header-bar .tag-user,
        .header-bar a.btn-gold {
            display: none;
        }

        .header-bar .filter-actions {
            width: 100%;
            align-items: center;
        }
    }

    /* Tarjetas */

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 16px;
        margin-bottom: 35px;
    }

    .metric-card {
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        transition: transform 0.2s, border-color 0.2s;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        border-color: #D4AF55;
    }

    .metric-icon {
        font-size: 24px;
        margin-bottom: 8px;
    }

    .metric-number {
        font-size: 28px;
        font-weight: 700;
        color: #F1CD73;
        margin-bottom: 4px;
    }

    .metric-label {
        font-size: 11px;
        font-weight: 600;
        color: #A9C2E8;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Secciones */

    .section-title {
        color: #F1CD73;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin: 30px 0 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Gráficos */

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .chart-card {
        min-width: 0;
        padding: 20px;
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
    }

    .chart-card h3 {
        margin: 0 0 20px;
        color: #F1CD73;
        font-size: 14px;
        text-align: center;
        letter-spacing: 1px;
    }

    .chart-wrapper {
        position: relative;
        height: 280px;
        width: 100%;
    }

    /* Tabla */

    .table-container {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #315B91;
        border-radius: 12px;
        background: rgba(16, 39, 73, 0.45);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        text-align: left;
    }

    thead th {
        background: rgba(16, 39, 73, 0.95);
        color: #F1CD73;
        padding: 14px 16px;
        border-bottom: 1px solid #315B91;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid rgba(49, 91, 145, 0.35);
        color: #FFFFFF;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover {
        background: rgba(212, 175, 85, 0.05);
    }

    .badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        display: inline-block;
    }

    .badge-facil {
        background: rgba(46, 125, 50, 0.3);
        border: 1px solid #4CAF50;
        color: #A5D6A7;
    }

    .badge-media {
        background: rgba(239, 108, 0, 0.3);
        border: 1px solid #FF9800;
        color: #FFE082;
    }

    .badge-dificil {
        background: rgba(198, 40, 40, 0.3);
        border: 1px solid #F44336;
        color: #FFCDD2;
    }

    .badge-sindatos {
        background: rgba(120, 144, 156, 0.3);
        border: 1px solid #90A4AE;
        color: #CFD8DC;
    }

    .tag-category {
        padding: 3px 8px;
        border-radius: 6px;
        background: rgba(31, 91, 160, 0.4);
        border: 1px solid #315B91;
        color: #DCE6F8;
        font-size: 11px;
    }

    .empty-message {
        color: #88A5CD;
        text-align: center;
        padding: 24px;
    }

    /* Paginación */

    .paginacion {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-pagina {
        padding: 10px 18px;
        background: #17365d;
        border: 1px solid #d4af55;
        border-radius: 8px;
        color: #f1cd73;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.2s ease;
    }

    .btn-pagina:hover {
        background: #d4af55;
        color: #0a1a33;
    }

    .paginacion span {
        color: #a9c2e8;
        font-size: 13px;
    }

    @media (max-width: 750px) {
        .admin-container {
            width: 96%;
            padding: 25px 15px;
        }

        .charts-grid {
            grid-template-columns: 1fr;
        }

        .header-bar {
            justify-content: center;
        }

        .header-bar a.btn-gold {
            display: none;
        }

        .filter-container {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-actions button,
        .filter-actions .btn-gold {
            width: 100%;
            text-align: center;
        }

        .filter-container select {
            width: 100%;
            min-width: 0;
        }
    }

    /* Celulares: tarjetas de métricas de a 2 y gráficos más bajos */
    @media (max-width: 600px) {
        .admin-subtitle {
            letter-spacing: 1.5px;
        }

        .admin-subtitle::before,
        .admin-subtitle::after {
            display: none;
        }

        .metrics-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        /* si la cantidad es impar, la última ocupa todo el ancho */
        .metric-card:last-child:nth-child(odd) {
            grid-column: 1 / -1;
        }

        .metric-card {
            padding: 14px 10px;
        }

        .metric-number {
            font-size: 22px;
        }

        .metric-label {
            font-size: 10px;
            letter-spacing: 0.5px;
        }

        .chart-card {
            padding: 14px 10px;
        }

        .chart-wrapper {
            height: 240px;
        }
    }

    /* Tabla de preguntas -> tarjetas (una por fila). Solo en pantalla: al imprimir sigue siendo tabla.
       El orden sigue disponible con el selector "Ordenar por". */
    @media screen and (max-width: 800px) {
        .table-container {
            overflow: visible;
            background: transparent;
            border: 0;
        }

        .tabla-responsive,
        .tabla-responsive tbody,
        .tabla-responsive tr,
        .tabla-responsive td {
            display: block;
            width: 100%;
        }

        .tabla-responsive thead {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
        }

        .tabla-responsive tr {
            margin-bottom: 14px;
            padding: 4px 0;
            background: rgba(16, 39, 73, 0.55);
            border: 1px solid #315B91;
            border-radius: 10px;
        }

        .tabla-responsive tbody tr:hover {
            background: rgba(16, 39, 73, 0.55);
        }

        .tabla-responsive tbody td {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 9px 14px;
            border-bottom: 1px solid rgba(49, 91, 145, 0.25);
            text-align: right;
            overflow-wrap: anywhere;
        }

        /* la regla base quita el borde de la última fila: se restaura entre celdas de cada tarjeta */
        .tabla-responsive tbody tr:last-child td {
            border-bottom: 1px solid rgba(49, 91, 145, 0.25);
        }

        .tabla-responsive tbody tr td:last-child,
        .tabla-responsive tbody tr:last-child td:last-child {
            border-bottom: 0;
        }

        .tabla-responsive td::before {
            content: attr(data-label);
            flex: 0 0 34%;
            max-width: 34%;
            text-align: left;
            color: #F1CD73;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* fila vacía */
        .tabla-responsive td:not([data-label]) {
            display: block;
            text-align: center;
        }

        .tabla-responsive td:not([data-label])::before {
            content: none;
        }

        /* enunciado: etiqueta arriba, texto debajo a todo el ancho */
        .tabla-responsive td.celda-principal {
            flex-direction: column;
            align-items: stretch;
            text-align: left;
        }

        .tabla-responsive td.celda-principal::before {
            flex: none;
            max-width: none;
        }
    }
</style>

<div class="admin-container">

    <div class="admin-emblem" aria-hidden="true">✦</div>

    <h1>PANEL DE ADMINISTRADOR</h1>

    <p class="admin-subtitle">
        MÉTRICAS & CONTROL DEL SISTEMA
    </p>

    <div class="header-bar">
        <span class="tag-user">ADMIN: {{username}}</span>

        <div class="filter-actions">
            <a href="admin/descargarPdf?periodo={{periodo}}"
               class="btn-gold"
               target="_blank">
                DESCARGAR REPORTE (PDF)
            </a>

            <a href="lobby" class="btn-gold">
                ← VOLVER AL LOBBY
            </a>
        </div>
    </div>

    <!-- FILTROS -->

    <form method="GET" action="admin" id="formAdmin" class="filter-container">

        <div>
            <label for="periodo">📅 PERÍODO DEL REPORTE</label>
        </div>

        <div class="filter-actions">

            <select name="periodo"
                    id="periodo"
                    onchange="this.form.submit()">

                <option value="dia" {{#es_dia}}selected{{/es_dia}}>
                    Día
                </option>

                <option value="semana" {{#es_semana}}selected{{/es_semana}}>
                    Semana
                </option>

                <option value="mes" {{#es_mes}}selected{{/es_mes}}>
                    Mes
                </option>

                <option value="anio" {{#es_anio}}selected{{/es_anio}}>
                    Año
                </option>

            </select>

        </div>

    </form>

    <!-- MÉTRICAS PRINCIPALES -->

    <div class="section-title">
        📊 RESUMEN GENERAL
    </div>

    <div class="metrics-grid">

        <div class="metric-card">
            <div class="metric-icon">👥</div>
            <div class="metric-number">{{total_jugadores}}</div>
            <div class="metric-label">Jugadores</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">⚔️</div>
            <div class="metric-number">{{total_partidas}}</div>
            <div class="metric-label">Partidas jugadas</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">📜</div>
            <div class="metric-number">{{preguntas_activas}}</div>
            <div class="metric-label">Preguntas del juego</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">📝</div>
            <div class="metric-number">{{preguntas_creadas}}</div>
            <div class="metric-label">Preguntas creadas</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">🆕</div>
            <div class="metric-number">{{usuarios_nuevos}}</div>
            <div class="metric-label">Usuarios nuevos</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">🎯</div>
            <div class="metric-number">{{porcentaje_correctas}}%</div>
            <div class="metric-label">Respuestas correctas</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">⚠️</div>
            <div class="metric-number">{{reportes_pendientes}}</div>
            <div class="metric-label">Reportes pendientes</div>
        </div>

    </div>

    <!-- GRÁFICOS -->

    <div class="section-title">
        🌎 DISTRIBUCIÓN DE USUARIOS
    </div>

    <div class="charts-grid">

        <div class="chart-card">
            <h3>USUARIOS POR PAÍS</h3>
            <div class="chart-wrapper">
                <canvas id="graficoPaises"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3>USUARIOS POR SEXO</h3>
            <div class="chart-wrapper">
                <canvas id="graficoSexos"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3>USUARIOS POR GRUPO DE EDAD</h3>
            <div class="chart-wrapper">
                <canvas id="graficoEdades"></canvas>
            </div>
        </div>

    </div>

    <!-- ESTADÍSTICAS DE PREGUNTAS -->

    <div class="section-title" id="balance-preguntas">
        📚 BALANCE Y DIFICULTAD DE PREGUNTAS
    </div>

    <div class="table-filters">

        <div class="filtro-grupo">
            <label for="filtroAnime">Anime</label>
            <select name="anime" id="filtroAnime" form="formAdmin">
                {{#animes}}
                    <option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{texto}}</option>
                {{/animes}}
            </select>
        </div>

        <div class="filtro-grupo">
            <label for="filtroCategoria">Categoría</label>
            <select name="categoria" id="filtroCategoria" form="formAdmin">
                {{#categorias}}
                    <option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{texto}}</option>
                {{/categorias}}
            </select>
        </div>

        <div class="filtro-grupo">
            <label for="filtroDificultad">Dificultad</label>
            <select name="dificultad" id="filtroDificultad" form="formAdmin">
                {{#dificultades}}
                    <option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{texto}}</option>
                {{/dificultades}}
            </select>
        </div>

        <div class="filtro-grupo">
            <label for="ordenarPor">Ordenar por</label>
            <select name="orden" id="ordenarPor" form="formAdmin">
                {{#ordenes}}
                    <option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{texto}}</option>
                {{/ordenes}}
            </select>
        </div>

        <a href="admin?periodo={{periodo}}#balance-preguntas" class="btn-gold">
        LIMPIAR
        </a>

        <span class="contador-resultados">
            Mostrando {{cantidad_preguntas}} preguntas
        </span>

    </div>

    <div class="table-container">

        <table id="tablaPreguntas" class="tabla-responsive">
            <thead>
            <tr>
                <th style="width: 38%;">Pregunta</th>
                <th>Anime</th>
                <th>Categoría</th>
                <th class="ordenable" data-campo="jugada" style="text-align: center;" title="Click para ordenar">
                    Jugada<span class="flecha"></span>
                </th>
                <th class="ordenable" data-campo="acertada" style="text-align: center;" title="Click para ordenar">
                    Acertada<span class="flecha"></span>
                </th>
                <th class="ordenable" data-campo="exito" style="text-align: center;" title="Click para ordenar">
                    % Éxito<span class="flecha"></span>
                </th>
                <th style="text-align: center;">Dificultad</th>
            </tr>
            </thead>

            <tbody>

            {{#preguntas}}

                <tr>
                    <td class="celda-principal" data-label="Pregunta">{{descripcion}}</td>

                    <td data-label="Anime">{{anime}}</td>

                    <td data-label="Categoría">
                        <span class="tag-category">
                            {{categoria}}
                        </span>
                    </td>

                    <td data-label="Jugada" style="text-align: center;">
                        {{veces_mostrada}}
                    </td>

                    <td data-label="Acertada" style="text-align: center;">
                        {{veces_acertada}}
                    </td>

                    <td data-label="% Éxito" style="text-align: center; font-weight: 700; color: #F1CD73;">
                        {{porcentaje_aciertos}}%
                    </td>

                    <td data-label="Dificultad" style="text-align: center;">
                        <span class="badge badge-{{dificultad}}">
                            {{dificultad}}
                        </span>
                    </td>
                </tr>

            {{/preguntas}}

            {{^preguntas}}

                <tr>
                    <td colspan="7" class="empty-message">
                        No hay preguntas que coincidan con los filtros seleccionados.
                    </td>
                </tr>

            {{/preguntas}}

            </tbody>
        </table>

    </div>

    <div class="paginacion">
        {{#hayAnterior}}
            <a href="{{paginaAnteriorUrl}}" class="btn-pagina">
                Anterior
            </a>
        {{/hayAnterior}}

        <span>
            Página {{paginaActual}} de {{totalPaginas}}
        </span>

        {{#haySiguiente}}
            <a href="{{paginaSiguienteUrl}}" class="btn-pagina">
                Siguiente
            </a>
        {{/haySiguiente}}
    </div>

</div>

<!-- DATOS DE LOS GRÁFICOS (JSON del controlador) -->

<div id="datos-graficos" hidden
     data-paises="{{paises_json}}"
     data-sexos="{{sexos_json}}"
     data-edades="{{edades_json}}"></div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // Los datos llegan en atributos data-* (ver #datos-graficos) y se leen como JSON.
        const datosGraficos = document.getElementById('datos-graficos').dataset;

        const paises = JSON.parse(datosGraficos.paises || '[]');
        const sexos = JSON.parse(datosGraficos.sexos || '[]');
        const edades = JSON.parse(datosGraficos.edades || '[]');

        // En celular: leyenda abajo, letra más chica
        const esMovil = window.matchMedia('(max-width: 600px)').matches;

        function crearGrafico(id, datos, tipo, colores) {

            const canvas = document.getElementById(id);

            if (!canvas) return;

            if (datos.length === 0) {
                canvas.parentElement.innerHTML =
                        '<p class="empty-message">No hay datos disponibles para este período.</p>';
                return;
            }

            new Chart(canvas, {

                type: tipo,

                data: {
                    labels: datos.map(item => item.etiqueta || 'Sin especificar'),

                    datasets: [{
                        label: 'Cantidad de usuarios',
                        data: datos.map(item => Number(item.cantidad)),
                        backgroundColor: colores,
                        borderColor: '#D4AF55',
                        borderWidth: 1
                    }]
                },

                options: {
                    responsive: true,
                    maintainAspectRatio: false,

                    plugins: {
                        legend: {
                            position: esMovil ? 'bottom' : 'top',
                            labels: {
                                color: '#DCE6F8',
                                boxWidth: esMovil ? 12 : 40,
                                font: {size: esMovil ? 11 : 12}
                            }
                        }
                    },

                    scales: tipo === 'bar' ? {
                        x: {
                            ticks: {
                                color: '#DCE6F8',
                                autoSkip: true,
                                maxRotation: 60,
                                font: {size: esMovil ? 10 : 12}
                            },
                            grid: {
                                color: 'rgba(255,255,255,0.08)'
                            }
                        },

                        y: {
                            beginAtZero: true,
                            ticks: {
                                precision: 0,
                                color: '#DCE6F8'
                            },
                            grid: {
                                color: 'rgba(255,255,255,0.08)'
                            }
                        }
                    } : {}
                }

            });
        }

        crearGrafico(
                'graficoPaises',
                paises,
                'bar',
                '#4F8EDC'
        );

        crearGrafico(
                'graficoSexos',
                sexos,
                'doughnut',
                ['#4F8EDC', '#D66CA8', '#D4AF55', '#75B798', '#A78BFA']
        );

        crearGrafico(
                'graficoEdades',
                edades,
                'bar',
                '#D4AF55'
        );

    });
</script>

<!-- FILTROS DE LA TABLA DE PREGUNTAS -->

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const formulario = document.getElementById('formAdmin');
        const selOrden = document.getElementById('ordenarPor');

        if (!formulario || !selOrden) return;

        function enviarFiltros() {
            formulario.action = 'admin#balance-preguntas';
            formulario.submit();
        }

        ['filtroAnime', 'filtroCategoria', 'filtroDificultad', 'ordenarPor'].forEach(function (id) {
            document.getElementById(id).addEventListener('change', enviarFiltros);
        });

        const actual = selOrden.value.split('_');

        document.querySelectorAll('#tablaPreguntas th.ordenable').forEach(function (th) {
            const campo = th.dataset.campo;
            const flecha = th.querySelector('.flecha');
            const activa = actual[0] === campo;

            th.classList.toggle('activo', activa);
            flecha.textContent = activa ? (actual[1] === 'desc' ? '▼' : '▲') : '↕';

            th.addEventListener('click', function () {
                const dir = (activa && actual[1] === 'desc') ? 'asc' : 'desc';
                selOrden.value = campo + '_' + dir;
                enviarFiltros();
            });
        });
    });
</script>