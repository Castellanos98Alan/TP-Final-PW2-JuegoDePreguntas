<style>
    * {
        box-sizing: border-box;
    }

    .admin-container {
        width: 92%;
        max-width: 1100px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .admin-emblem {
        width: 54px;
        height: 54px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #D4AF55;
        border-radius: 50%;
        color: #F1CD73;
        font-size: 26px;
    }

    .admin-container h1 {
        margin: 0;
        text-align: center;
        color: #F1CD73;
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 700;
        letter-spacing: 1px;
    }

    .admin-subtitle {
        margin: 6px 0 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        color: #DCE6F8;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-align: center;
    }

    .admin-subtitle::before, .admin-subtitle::after {
        content: "";
        width: 32px;
        height: 1px;
        background: #D4AF55;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(185, 139, 59, 0.35);
    }

    .tag-user {
        color: #F1CD73;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .btn-gold {
        padding: 8px 18px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
        display: inline-block;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    /* Tarjetas de Métricas */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 16px;
        margin-bottom: 35px;
    }

    .metric-card {
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        transition: transform 0.2s, border-color 0.2s;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        border-color: #D4AF55;
    }

    .metric-icon {
        font-size: 24px;
        margin-bottom: 8px;
    }

    .metric-number {
        font-size: 28px;
        font-weight: 700;
        color: #F1CD73;
        margin-bottom: 4px;
    }

    .metric-label {
        font-size: 11px;
        font-weight: 600;
        color: #A9C2E8;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Tabla de Preguntas */
    .section-title {
        color: #F1CD73;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin: 25px 0 12px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .table-container {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #315B91;
        border-radius: 12px;
        background: rgba(16, 39, 73, 0.45);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        text-align: left;
    }

    thead th {
        background: rgba(16, 39, 73, 0.95);
        color: #F1CD73;
        padding: 14px 16px;
        border-bottom: 1px solid #315B91;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid rgba(49, 91, 145, 0.35);
        color: #FFFFFF;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover {
        background: rgba(212, 175, 85, 0.05);
    }

    .badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        display: inline-block;
    }

    .badge-facil { background: rgba(46, 125, 50, 0.3); border: 1px solid #4CAF50; color: #A5D6A7; }
    .badge-media { background: rgba(239, 108, 0, 0.3); border: 1px solid #FF9800; color: #FFE082; }
    .badge-dificil { background: rgba(198, 40, 40, 0.3); border: 1px solid #F44336; color: #FFCDD2; }
    .badge-sindatos { background: rgba(120, 144, 156, 0.3); border: 1px solid #90A4AE; color: #CFD8DC; }

    .tag-category {
        padding: 3px 8px;
        border-radius: 6px;
        background: rgba(31, 91, 160, 0.4);
        border: 1px solid #315B91;
        color: #DCE6F8;
        font-size: 11px;
    }
</style>

<div class="admin-container">
    <div class="admin-emblem" aria-hidden="true">✦</div>
    <h1>PANEL DE ADMINISTRADOR</h1>
    <p class="admin-subtitle">MÉTRICAS & CONTROL DEL SISTEMA</p>

    <div class="header-bar">
        <span class="tag-user">ADMIN: {{username}}</span>
        <a href="?controller=lobby&method=show" class="btn-gold">← VOLVER AL LOBBY</a>
    </div>

    <!-- Tarjetas de Métricas -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-icon">👥</div>
            <div class="metric-number">{{total_jugadores}}</div>
            <div class="metric-label">Jugadores Totales</div>
        </div>
        <div class="metric-card">
            <div class="metric-icon">⚔️</div>
            <div class="metric-number">{{total_partidas}}</div>
            <div class="metric-label">Partidas Jugadas</div>
        </div>
        <div class="metric-card">
            <div class="metric-icon">📜</div>
            <div class="metric-number">{{preguntas_activas}}</div>
            <div class="metric-label">Preguntas Activas</div>
        </div>
        <div class="metric-card">
            <div class="metric-icon">⚠️</div>
            <div class="metric-number">{{reportes_pendientes}}</div>
            <div class="metric-label">Reportes Pendientes</div>
        </div>
    </div>

    <!-- Estadísticas de Preguntas -->
    <div class="section-title">
        <span>📊 BALANCE Y DIFICULTAD DE PREGUNTAS</span>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th style="width: 45%;">Pregunta</th>
                    <th>Categoría</th>
                    <th style="text-align: center;">Jugada</th>
                    <th style="text-align: center;">Acertada</th>
                    <th style="text-align: center;">% Éxito</th>
                    <th style="text-align: center;">Dificultad</th>
                </tr>
            </thead>
            <tbody>
                {{#preguntas}}
                <tr>
                    <td>{{descripcion}}</td>
                    <td><span class="tag-category">{{categoria}}</span></td>
                    <td style="text-align: center;">{{veces_mostrada}}</td>
                    <td style="text-align: center;">{{veces_acertada}}</td>
                    <td style="text-align: center; font-weight: 700; color: #F1CD73;">{{porcentaje_aciertos}}%</td>
                    <td style="text-align: center;">
                        <span class="badge badge-{{dificultad}}">{{dificultad}}</span>
                    </td>
                </tr>
                {{/preguntas}}
                {{^preguntas}}
                <tr>
                    <td colspan="6" style="text-align: center; color: #88A5CD; padding: 24px;">
                        No hay preguntas activas registradas en la base de datos.
                    </td>
                </tr>
                {{/preguntas}}
            </tbody>
        </table>
    </div>
</div>