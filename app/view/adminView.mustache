
<style>
    * {
        box-sizing: border-box;
    }

    .admin-container {
        width: 92%;
        max-width: 1200px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .admin-emblem {
        width: 54px;
        height: 54px;
        margin: 0 auto 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #D4AF55;
        border-radius: 50%;
        color: #F1CD73;
        font-size: 26px;
    }

    .admin-container h1 {
        margin: 0;
        text-align: center;
        color: #F1CD73;
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 700;
        letter-spacing: 1px;
    }

    .admin-subtitle {
        margin: 6px 0 25px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        color: #DCE6F8;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 3px;
        text-align: center;
    }

    .admin-subtitle::before,
    .admin-subtitle::after {
        content: "";
        width: 32px;
        height: 1px;
        background: #D4AF55;
    }

    .header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 25px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(185, 139, 59, 0.35);
    }

    .tag-user {
        color: #F1CD73;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
    }

    .btn-gold {
        padding: 9px 18px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .btn-print {
        background: transparent;
        color: #F1CD73;
        border: 1px solid #D4AF55;
    }

    .btn-print:hover {
        background: #D4AF55;
        color: #0A1A33;
    }

    /* Filtros */

    .filter-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        padding: 18px;
        margin-bottom: 28px;
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
    }

    .filter-container label {
        color: #F1CD73;
        font-size: 13px;
        font-weight: bold;
    }

    .filter-container select {
        min-width: 180px;
        padding: 10px 14px;
        border: 1px solid #D4AF55;
        border-radius: 7px;
        background: #102749;
        color: white;
        outline: none;
    }

    .filter-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* Tarjetas */

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 16px;
        margin-bottom: 35px;
    }

    .metric-card {
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        transition: transform 0.2s, border-color 0.2s;
    }

    .metric-card:hover {
        transform: translateY(-3px);
        border-color: #D4AF55;
    }

    .metric-icon {
        font-size: 24px;
        margin-bottom: 8px;
    }

    .metric-number {
        font-size: 28px;
        font-weight: 700;
        color: #F1CD73;
        margin-bottom: 4px;
    }

    .metric-label {
        font-size: 11px;
        font-weight: 600;
        color: #A9C2E8;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* Secciones */

    .section-title {
        color: #F1CD73;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin: 30px 0 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Gráficos */

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .chart-card {
        min-width: 0;
        padding: 20px;
        background: rgba(16, 39, 73, 0.55);
        border: 1px solid #315B91;
        border-radius: 12px;
    }

    .chart-card h3 {
        margin: 0 0 20px;
        color: #F1CD73;
        font-size: 14px;
        text-align: center;
        letter-spacing: 1px;
    }

    .chart-wrapper {
        position: relative;
        height: 280px;
        width: 100%;
    }

    /* Tabla */

    .table-container {
        width: 100%;
        overflow-x: auto;
        border: 1px solid #315B91;
        border-radius: 12px;
        background: rgba(16, 39, 73, 0.45);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        text-align: left;
    }

    thead th {
        background: rgba(16, 39, 73, 0.95);
        color: #F1CD73;
        padding: 14px 16px;
        border-bottom: 1px solid #315B91;
        font-weight: 600;
        font-size: 11px;
        text-transform: uppercase;
    }

    tbody td {
        padding: 13px 16px;
        border-bottom: 1px solid rgba(49, 91, 145, 0.35);
        color: #FFFFFF;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    tbody tr:hover {
        background: rgba(212, 175, 85, 0.05);
    }

    .badge {
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        display: inline-block;
    }

    .badge-facil {
        background: rgba(46, 125, 50, 0.3);
        border: 1px solid #4CAF50;
        color: #A5D6A7;
    }

    .badge-media {
        background: rgba(239, 108, 0, 0.3);
        border: 1px solid #FF9800;
        color: #FFE082;
    }

    .badge-dificil {
        background: rgba(198, 40, 40, 0.3);
        border: 1px solid #F44336;
        color: #FFCDD2;
    }

    .badge-sindatos {
        background: rgba(120, 144, 156, 0.3);
        border: 1px solid #90A4AE;
        color: #CFD8DC;
    }

    .tag-category {
        padding: 3px 8px;
        border-radius: 6px;
        background: rgba(31, 91, 160, 0.4);
        border: 1px solid #315B91;
        color: #DCE6F8;
        font-size: 11px;
    }

    .empty-message {
        color: #88A5CD;
        text-align: center;
        padding: 24px;
    }

    @media (max-width: 750px) {
        .admin-container {
            width: 96%;
            padding: 25px 15px;
        }

        .charts-grid {
            grid-template-columns: 1fr;
        }

        .header-bar {
            justify-content: center;
        }

        .filter-container {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-actions {
            flex-direction: column;
        }

        .filter-actions button {
            width: 100%;
        }
    }

    /* Impresión */

    @media print {
        @page {
            size: A4;
            margin: 12mm;
        }

        body {
            background: white !important;
            color: black !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .admin-container {
            width: 100%;
            max-width: none;
            margin: 0;
            padding: 10px;
            box-shadow: none;
            border: none;
            background: white !important;
            color: black !important;
        }

        .filter-container,
        .header-bar a,
        .btn-print {
            display: none !important;
        }

        .admin-container h1,
        .section-title,
        .chart-card h3 {
            color: #172B4D !important;
        }

        .metric-card,
        .chart-card,
        .table-container {
            background: white !important;
            border: 1px solid #aaa !important;
            break-inside: avoid;
        }

        .metric-number,
        .metric-label,
        tbody td,
        thead th {
            color: black !important;
        }

        thead th {
            background: #eeeeee !important;
        }

        .charts-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .chart-wrapper {
            height: 220px;
        }

        tr {
            break-inside: avoid;
        }
    }
</style>

<div class="admin-container">

    <div class="admin-emblem" aria-hidden="true">✦</div>

    <h1>PANEL DE ADMINISTRADOR</h1>

    <p class="admin-subtitle">
        MÉTRICAS & CONTROL DEL SISTEMA
    </p>

    <div class="header-bar">
        <span class="tag-user">ADMIN: {{username}}</span>

        <div class="filter-actions">
            <button class="btn-gold btn-print"
                    type="button"
                    onclick="window.print()">
                 IMPRIMIR REPORTE
            </button>

            <a href="lobby" class="btn-gold">
                ← VOLVER AL LOBBY
            </a>
        </div>
    </div>

    <!-- FILTROS -->

    <form method="GET" action="admin" class="filter-container">

        <div>
            <label for="periodo">📅 PERÍODO DEL REPORTE</label>
        </div>

        <div class="filter-actions">

            <select name="periodo"
                    id="periodo"
                    onchange="this.form.submit()">

                <option value="dia" {{#es_dia}}selected{{/es_dia}}>
                    Día
                </option>

                <option value="semana" {{#es_semana}}selected{{/es_semana}}>
                    Semana
                </option>

                <option value="mes" {{#es_mes}}selected{{/es_mes}}>
                    Mes
                </option>

                <option value="anio" {{#es_anio}}selected{{/es_anio}}>
                    Año
                </option>

            </select>

        </div>

    </form>

    <!-- MÉTRICAS PRINCIPALES -->

    <div class="section-title">
        📊 RESUMEN GENERAL
    </div>

    <div class="metrics-grid">

        <div class="metric-card">
            <div class="metric-icon">👥</div>
            <div class="metric-number">{{total_jugadores}}</div>
            <div class="metric-label">Jugadores</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">⚔️</div>
            <div class="metric-number">{{total_partidas}}</div>
            <div class="metric-label">Partidas jugadas</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">📜</div>
            <div class="metric-number">{{preguntas_activas}}</div>
            <div class="metric-label">Preguntas del juego</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">📝</div>
            <div class="metric-number">{{preguntas_creadas}}</div>
            <div class="metric-label">Preguntas creadas</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">🆕</div>
            <div class="metric-number">{{usuarios_nuevos}}</div>
            <div class="metric-label">Usuarios nuevos</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">🎯</div>
            <div class="metric-number">{{porcentaje_correctas}}%</div>
            <div class="metric-label">Respuestas correctas</div>
        </div>

        <div class="metric-card">
            <div class="metric-icon">⚠️</div>
            <div class="metric-number">{{reportes_pendientes}}</div>
            <div class="metric-label">Reportes pendientes</div>
        </div>

    </div>

    <!-- GRÁFICOS -->

    <div class="section-title">
        🌎 DISTRIBUCIÓN DE USUARIOS
    </div>

    <div class="charts-grid">

        <div class="chart-card">
            <h3>USUARIOS POR PAÍS</h3>
            <div class="chart-wrapper">
                <canvas id="graficoPaises"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3>USUARIOS POR SEXO</h3>
            <div class="chart-wrapper">
                <canvas id="graficoSexos"></canvas>
            </div>
        </div>

        <div class="chart-card">
            <h3>USUARIOS POR GRUPO DE EDAD</h3>
            <div class="chart-wrapper">
                <canvas id="graficoEdades"></canvas>
            </div>
        </div>

    </div>

    <!-- ESTADÍSTICAS DE PREGUNTAS -->

    <div class="section-title">
        📚 BALANCE Y DIFICULTAD DE PREGUNTAS
    </div>

    <div class="table-container">

        <table>
            <thead>
                <tr>
                    <th style="width: 45%;">Pregunta</th>
                    <th>Categoría</th>
                    <th style="text-align: center;">Jugada</th>
                    <th style="text-align: center;">Acertada</th>
                    <th style="text-align: center;">% Éxito</th>
                    <th style="text-align: center;">Dificultad</th>
                </tr>
            </thead>

            <tbody>

                {{#preguntas}}

                <tr>
                    <td>{{descripcion}}</td>

                    <td>
                        <span class="tag-category">
                            {{categoria}}
                        </span>
                    </td>

                    <td style="text-align: center;">
                        {{veces_mostrada}}
                    </td>

                    <td style="text-align: center;">
                        {{veces_acertada}}
                    </td>

                    <td style="text-align: center; font-weight: 700; color: #F1CD73;">
                        {{porcentaje_aciertos}}%
                    </td>

                    <td style="text-align: center;">
                        <span class="badge badge-{{dificultad}}">
                            {{dificultad}}
                        </span>
                    </td>
                </tr>

                {{/preguntas}}

                {{^preguntas}}

                <tr>
                    <td colspan="6" class="empty-message">
                        No hay preguntas activas registradas en la base de datos.
                    </td>
                </tr>

                {{/preguntas}}

            </tbody>
        </table>

    </div>

</div>

<!-- CHART.JS -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const paises = {{{paises_json}}} || [];
    const sexos = {{{sexos_json}}} || [];
    const edades = {{{edades_json}}} || [];

    function crearGrafico(id, datos, tipo, colores) {

        const canvas = document.getElementById(id);

        if (!canvas) return;

        if (datos.length === 0) {
            canvas.parentElement.innerHTML =
                '<p class="empty-message">No hay datos disponibles para este período.</p>';
            return;
        }

        new Chart(canvas, {

            type: tipo,

            data: {
                labels: datos.map(item => item.etiqueta || 'Sin especificar'),  //labels toma las etiquetas que devolvió SQL: países, sexos o grupos de edad.

                datasets: [{
                    label: 'Cantidad de usuarios',
                    data: datos.map(item => Number(item.cantidad)), // data toma cantidad y Number() transforma el dato a número para que Chart.js lo interprete correctamente
                    backgroundColor: colores,
                    borderColor: '#D4AF55',
                    borderWidth: 1
                }]
            },

            options: {
                responsive: true,
                maintainAspectRatio: false,

                plugins: {
                    legend: {
                        labels: {
                            color: '#DCE6F8'
                        }
                    }
                },

                scales: tipo === 'bar' ? {
                    x: {
                        ticks: {
                            color: '#DCE6F8'
                        },
                        grid: {
                            color: 'rgba(255,255,255,0.08)'
                        }
                    },

                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0,
                            color: '#DCE6F8'
                        },
                        grid: {
                            color: 'rgba(255,255,255,0.08)'
                        }
                    }
                } : {}
            }

        });
    }

    crearGrafico(
        'graficoPaises',
        paises,
        'bar',
        '#4F8EDC'
    );

    crearGrafico(
        'graficoSexos',
        sexos,
        'doughnut',
        ['#4F8EDC', '#D66CA8', '#D4AF55', '#75B798', '#A78BFA']
    );

    crearGrafico(
        'graficoEdades',
        edades,
        'bar',
        '#D4AF55'
    );

});
</script>
