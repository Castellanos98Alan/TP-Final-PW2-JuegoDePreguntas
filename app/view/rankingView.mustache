<style>
    * {
        box-sizing: border-box;
    }

    .ranking-container {
        width: 100%;
        max-width: 900px;
        margin: 20px auto 40px;
        padding: 0 16px;
    }

    .ranking-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .ranking-header h1 {
        font-family: 'Permanent Marker', cursive;
        color: #f5c84b;
        font-size: clamp(24px, 6vw, 32px);
        letter-spacing: 1px;
        margin: 0 0 6px;
    }

    .ranking-header p {
        color: #a9bfdf;
        font-size: 15px;
        margin: 0;
    }

    .ranking-card {
        background: linear-gradient(160deg, rgba(3, 14, 38, .92), rgba(8, 31, 77, .92));
        border: 1px solid #d4a72c;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 0 25px rgba(0, 0, 0, 0.4), 0 0 15px rgba(245, 200, 75, 0.15);
        overflow-x: auto;
    }

    .ranking-tabla {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }

    .ranking-tabla th {
        color: #f5c84b;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 12px 14px;
        border-bottom: 1px solid rgba(245, 200, 75, 0.25);
    }

    .ranking-tabla td {
        padding: 14px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        color: #e0e8f5;
        vertical-align: middle;
    }

    .ranking-fila:hover {
        background: rgba(245, 200, 75, 0.05);
    }

    .ranking-fila.es-propio {
        background: rgba(212, 175, 85, 0.15);
        border: 1px solid #f5c84b;
    }

    .posicion-badge {
        font-weight: 700;
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 32px;
    }

    .pos-1 { color: #ffd700; font-size: 22px; }
    .pos-2 { color: #c0c0c0; font-size: 20px; }
    .pos-3 { color: #cd7f32; font-size: 20px; }

    .jugador-info {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .jugador-info > div {
        min-width: 0;
    }

    .avatar-mini {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
        border: 2px solid #d4a72c;
    }

    .jugador-link {
        color: #f5c84b;
        text-decoration: none;
        font-weight: bold;
        font-size: 15px;
        overflow-wrap: anywhere;
    }

    .jugador-link:hover {
        text-decoration: underline;
    }

    .jugador-nombre {
        font-size: 12px;
        color: #8da6cb;
        overflow-wrap: anywhere;
    }

    .puntaje-col {
        font-size: 18px;
        font-weight: 900;
        color: #f5c84b;
        text-align: right;
        white-space: nowrap;
    }

    .acciones-ranking {
        margin-top: 25px;
        display: flex;
        justify-content: center;
    }

    .btn-volver {
        padding: 10px 24px;
        background: rgba(16, 39, 73, 0.6);
        border: 1px solid #d4a72c;
        border-radius: 20px;
        color: #f5c84b;
        text-decoration: none;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-volver:hover {
        background: #d4a72c;
        color: #06132d;
    }

    .ranking-filtros-bar {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 22px;
        background: rgba(4, 18, 48, 0.7);
        border: 1px solid rgba(212, 167, 44, 0.4);
        padding: 12px 20px;
        border-radius: 14px;
    }

    .ranking-tabs {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 20px;
    }

    .ranking-tab-btn {
        padding: 10px 22px;
        background: rgba(4, 18, 48, 0.75);
        border: 1px solid rgba(212, 167, 44, 0.4);
        border-radius: 12px;
        color: #a9bfdf;
        font-weight: bold;
        font-size: 14.5px;
        cursor: pointer;
        transition: all 0.25s ease-in-out;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .ranking-tab-btn:hover {
        background: rgba(212, 167, 44, 0.15);
        color: #f5c84b;
        border-color: #d4a72c;
    }

    .ranking-tab-btn.activa {
        background: linear-gradient(135deg, #d4a72c, #f5c84b);
        color: #030e26;
        border-color: #ffd700;
        box-shadow: 0 0 14px rgba(245, 200, 75, 0.4);
    }

    .filtro-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ranking-filtros-bar label {
        color: #f5c84b;
        font-weight: bold;
        font-size: 14px;
        white-space: nowrap;
    }

    .filtro-select {
        background: #030e26;
        color: #f3f5fa;
        border: 1px solid #d4a72c;
        padding: 7px 12px;
        border-radius: 8px;
        font-size: 14px;
        outline: none;
        cursor: pointer;
    }

    .filtro-select:focus {
        box-shadow: 0 0 8px rgba(245, 200, 75, 0.5);
    }

    #rankingCuerpo {
        transition: opacity 0.25s ease-in-out;
    }

    /* ===== PAGINACIÓN ===== */
    .ranking-paginacion {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 22px;
        flex-wrap: wrap;
    }

    .pag-btn {
        padding: 7px 14px;
        background: rgba(4, 18, 48, 0.85);
        border: 1px solid rgba(212, 167, 44, 0.5);
        border-radius: 8px;
        color: #f5c84b;
        font-weight: bold;
        font-size: 13.5px;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

    .pag-btn:hover:not(:disabled) {
        background: #d4a72c;
        color: #06132d;
        box-shadow: 0 0 10px rgba(245, 200, 75, 0.4);
    }

    .pag-btn.activa {
        background: #d4a72c;
        color: #06132d;
        border-color: #ffd700;
        box-shadow: 0 0 12px rgba(245, 200, 75, 0.6);
        pointer-events: none;
    }

    .pag-btn:disabled {
        opacity: 0.35;
        cursor: not-allowed;
        border-color: rgba(255, 255, 255, 0.1);
    }

    .pag-info {
        width: 100%;
        text-align: center;
        font-size: 12.5px;
        color: #8da6cb;
        margin-top: 10px;
    }

    /* ===== RESPONSIVE MOBILE ===== */
    @media (max-width: 650px) {
        .ranking-container {
            margin: 14px auto 30px;
            padding: 0 12px;
        }

        .ranking-header {
            margin-bottom: 18px;
        }

        .ranking-header p {
            font-size: 13px;
        }

        .ranking-tabs {
            gap: 8px;
            margin-bottom: 16px;
        }

        .ranking-tab-btn {
            flex: 1;
            justify-content: center;
            padding: 9px 12px;
            font-size: 13px;
        }

        .ranking-filtros-bar {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            padding: 12px;
            margin-bottom: 16px;
        }

        .filtro-item {
            flex-direction: column;
            align-items: stretch;
            gap: 5px;
        }

        .ranking-filtros-bar label {
            font-size: 12px;
        }

        .filtro-select {
            width: 100%;
            padding: 9px 10px;
        }

        .ranking-card {
            padding: 14px 10px;
            border-radius: 14px;
            overflow-x: visible;
        }

        /* Tabla -> tarjetas de leaderboard */
        .ranking-tabla thead {
            display: none;
        }

        .ranking-tabla tbody {
            display: flex;
            flex-direction: column;
            gap: 10px;
            width: 100%;
        }

        .ranking-tabla tr.ranking-fila {
            display: grid;
            grid-template-columns: auto 1fr auto;
            column-gap: 10px;
            row-gap: 4px;
            align-items: center;
            padding: 12px;
            background: rgba(6, 22, 54, 0.72);
            border: 1px solid rgba(212, 167, 44, 0.3);
            border-radius: 12px;
        }

        .ranking-tabla tr.ranking-fila.es-propio {
            background: rgba(212, 175, 85, 0.18);
            border: 1px solid #f5c84b;
        }

        .ranking-tabla td {
            padding: 0;
            border-bottom: none;
        }

        /* Puesto */
        .ranking-tabla td:nth-child(1) {
            grid-column: 1;
            grid-row: 1 / 3;
            align-self: center;
        }

        /* Jugador */
        .ranking-tabla td:nth-child(2) {
            grid-column: 2;
            grid-row: 1;
            min-width: 0;
        }

        /* Ubicación */
        .ranking-tabla td:nth-child(3) {
            grid-column: 2 / 4;
            grid-row: 2;
            font-size: 12px !important;
            color: #8da6cb !important;
            padding-top: 4px;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
        }

        /* Puntaje */
        .ranking-tabla td:nth-child(4) {
            grid-column: 3;
            grid-row: 1;
            align-self: center;
            font-size: 16px;
        }

        .avatar-mini {
            width: 36px;
            height: 36px;
        }

        .jugador-info {
            gap: 9px;
        }

        .jugador-link {
            font-size: 14px;
        }

        .ranking-paginacion {
            gap: 6px;
            margin-top: 18px;
        }

        .pag-btn {
            padding: 8px 12px;
            font-size: 13px;
        }
    }
</style>

<div class="ranking-container">
    <div class="ranking-header">
        <h1>🏆 SALÓN DE LA FAMA</h1>
    </div>

    <!-- Pestañas Tipo de Ranking -->
    <div class="ranking-tabs">
        <button type="button" class="ranking-tab-btn {{^es_historico}}activa{{/es_historico}}" id="tabMensual" data-tipo="mensual">
            📅 Ranking Mensual
        </button>
        <button type="button" class="ranking-tab-btn {{#es_historico}}activa{{/es_historico}}" id="tabHistorico" data-tipo="historico">
            🏆 Ranking Histórico
        </button>
    </div>

    <!-- Barra de Filtros Dinámica (AJAX automático) -->
    <div class="ranking-filtros-bar" id="rankingFiltrosBar" style="{{#es_historico}}display:none;{{/es_historico}}">
        <div class="filtro-item">
            <label for="selectMes">📅 Mes:</label>
            <select id="selectMes" class="filtro-select">
                {{#meses}}
                    <option value="{{numero}}" {{#seleccionado}}selected{{/seleccionado}}>{{nombre}}</option>
                {{/meses}}
            </select>
        </div>

        <div class="filtro-item">
            <label for="selectAnio">Año:</label>
            <select id="selectAnio" class="filtro-select">
                {{#anios}}
                    <option value="{{anio}}" {{#seleccionado}}selected{{/seleccionado}}>{{anio}}</option>
                {{/anios}}
            </select>
        </div>
    </div>

    <div class="ranking-card">
        <table class="ranking-tabla" id="tablaRanking" {{^hay_jugadores}}style="display:none;"{{/hay_jugadores}}>
            <thead>
            <tr>
                <th style="width: 70px;">Puesto</th>
                <th>Jugador</th>
                <th>Ubicación</th>
                <th style="text-align: right;" id="colPuntos">{{#es_historico}}Puntos Totales{{/es_historico}}{{^es_historico}}Puntos Mes{{/es_historico}}</th>
            </tr>
            </thead>
            <tbody id="rankingCuerpo">
            {{#jugadores}}
                <tr class="ranking-fila {{#es_usuario_actual}}es-propio{{/es_usuario_actual}}">
                    <td>
                    <span class="posicion-badge {{#es_primero}}pos-1{{/es_primero}}{{#es_segundo}}pos-2{{/es_segundo}}{{#es_tercero}}pos-3{{/es_tercero}}">
                        {{#es_primero}}🥇{{/es_primero}}
                        {{#es_segundo}}🥈{{/es_segundo}}
                        {{#es_tercero}}🥉{{/es_tercero}}
                        {{^es_podio}}#{{posicion}}{{/es_podio}}
                    </span>
                    </td>
                    <td>
                        <div class="jugador-info">
                            <img src="public/{{foto_perfil}}" alt="{{username}}" class="avatar-mini">
                            <div>
                                <a href="perfil/{{id}}" class="jugador-link">
                                    {{username}} {{#es_usuario_actual}}(Tú){{/es_usuario_actual}}
                                </a>
                                <div class="jugador-nombre">{{nombre_completo}}</div>
                            </div>
                        </div>
                    </td>
                    <td style="color: #a9bfdf; font-size: 13px;">
                        {{ciudad}}, {{pais}}
                    </td>
                    <td class="puntaje-col">
                        {{puntaje_acumulado}} pts
                    </td>
                </tr>
            {{/jugadores}}
            </tbody>
        </table>

        <!-- Controles de Paginación -->
        <div id="paginacionRanking" class="ranking-paginacion" {{^tiene_paginas}}style="display:none;"{{/tiene_paginas}}>
            <button type="button" class="pag-btn" id="pagAnterior" {{^tiene_anterior}}disabled{{/tiene_anterior}}>‹ Anterior</button>
            <div id="pagNumeros" style="display:flex; gap:6px; flex-wrap:wrap; justify-content:center;">
                {{#paginas}}
                    <button type="button" class="pag-btn {{#es_actual}}activa{{/es_actual}}" data-pagina="{{numero}}">{{numero}}</button>
                {{/paginas}}
            </div>
            <button type="button" class="pag-btn" id="pagSiguiente" {{^tiene_siguiente}}disabled{{/tiene_siguiente}}>Siguiente ›</button>
        </div>
        <div id="pagInfo" class="pag-info">
            {{#hay_jugadores}}Página {{pagina_actual}} de {{total_paginas}} ({{total_jugadores}} jugadores){{/hay_jugadores}}
        </div>

        <div id="rankingVacio" style="{{#hay_jugadores}}display:none;{{/hay_jugadores}} text-align:center; color:#a9bfdf; padding: 40px;">
            <span id="rankingVacioTexto">
                {{#es_historico}}Aún no hay partidas registradas en el juego.{{/es_historico}}
                {{^es_historico}}Aún no hay partidas registradas en el período seleccionado.{{/es_historico}}
            </span>
        </div>
    </div>

    <!-- Botón Volver al Lobby -->
    <div class="acciones-ranking">
        <a href="lobby" class="btn-volver">← Volver al Lobby</a>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabMensual = document.getElementById('tabMensual');
        const tabHistorico = document.getElementById('tabHistorico');
        const rankingFiltrosBar = document.getElementById('rankingFiltrosBar');
        const selectMes = document.getElementById('selectMes');
        const selectAnio = document.getElementById('selectAnio');
        const colPuntos = document.getElementById('colPuntos');
        const rankingCuerpo = document.getElementById('rankingCuerpo');
        const rankingVacio = document.getElementById('rankingVacio');
        const rankingVacioTexto = document.getElementById('rankingVacioTexto');
        const tablaRanking = document.getElementById('tablaRanking');
        const paginacionRanking = document.getElementById('paginacionRanking');
        const pagNumeros = document.getElementById('pagNumeros');
        const pagAnterior = document.getElementById('pagAnterior');
        const pagSiguiente = document.getElementById('pagSiguiente');
        const pagInfo = document.getElementById('pagInfo');

        let tipoActual = '{{tipo}}' || 'mensual';
        let paginaActual = {{pagina_actual}};
        let totalPaginas = {{total_paginas}};

        async function cargarRankingAjax(pagina = 1) {
            paginaActual = pagina;
            rankingCuerpo.style.opacity = '0.35';

            let url = `ranking/obtenerRankingAjax?tipo=${encodeURIComponent(tipoActual)}&pagina=${encodeURIComponent(paginaActual)}`;
            if (tipoActual === 'mensual') {
                const mes = selectMes.value;
                const anio = selectAnio.value;
                url += `&mes=${encodeURIComponent(mes)}&anio=${encodeURIComponent(anio)}`;
            }

            try {
                const respuesta = await fetch(url);
                if (!respuesta.ok) {
                    throw new Error('Error al consultar el servidor');
                }
                const data = await respuesta.json();

                if (!data.success || !data.jugadores || data.jugadores.length === 0) {
                    rankingCuerpo.innerHTML = '';
                    tablaRanking.style.display = 'none';
                    paginacionRanking.style.display = 'none';
                    pagInfo.style.display = 'none';
                    rankingVacioTexto.textContent = (tipoActual === 'historico') 
                        ? 'Aún no hay partidas registradas en el juego.' 
                        : 'Aún no hay partidas registradas en el período seleccionado.';
                    rankingVacio.style.display = 'block';
                    return;
                }

                colPuntos.textContent = (tipoActual === 'historico') ? 'Puntos Totales' : 'Puntos Mes';
                tablaRanking.style.display = 'table';
                rankingVacio.style.display = 'none';
                totalPaginas = data.total_paginas || 1;
                paginaActual = data.pagina_actual || 1;

                let htmlFilas = '';
                data.jugadores.forEach(j => {
                    let badge = `#${j.posicion}`;
                    let clasePos = '';

                    if (j.posicion === 1) {
                        badge = '🥇';
                        clasePos = 'pos-1';
                    } else if (j.posicion === 2) {
                        badge = '🥈';
                        clasePos = 'pos-2';
                    } else if (j.posicion === 3) {
                        badge = '🥉';
                        clasePos = 'pos-3';
                    }

                    const filaPropia = j.es_usuario_actual ? 'es-propio' : '';
                    const tagTu = j.es_usuario_actual ? ' (Tú)' : '';

                    htmlFilas += `
                    <tr class="ranking-fila ${filaPropia}">
                        <td>
                            <span class="posicion-badge ${clasePos}">
                                ${badge}
                            </span>
                        </td>
                        <td>
                            <div class="jugador-info">
                                <img src="public/${j.foto_perfil}" alt="${j.username}" class="avatar-mini">
                                <div>
                                    <a href="perfil/${j.id}" class="jugador-link">
                                        ${j.username}${tagTu}
                                    </a>
                                    <div class="jugador-nombre">${j.nombre_completo}</div>
                                </div>
                            </div>
                        </td>
                        <td style="color: #a9bfdf; font-size: 13px;">
                            ${j.ciudad}, ${j.pais}
                        </td>
                        <td class="puntaje-col">
                            ${j.puntaje_acumulado} pts
                        </td>
                    </tr>
                `;
                });

                rankingCuerpo.innerHTML = htmlFilas;

                // Renderizar paginador
                actualizarControlesPaginacion(data.pagina_actual, data.total_paginas, data.total_jugadores);

            } catch (err) {
                console.error('Error al actualizar ranking vía AJAX:', err);
            } finally {
                rankingCuerpo.style.opacity = '1';
            }
        }

        function actualizarControlesPaginacion(actual, total, totalJugadores) {
            if (total > 1) {
                paginacionRanking.style.display = 'flex';
                pagInfo.style.display = 'block';
                pagInfo.textContent = `Página ${actual} de ${total} (${totalJugadores} jugadores)`;

                pagAnterior.disabled = (actual <= 1);
                pagSiguiente.disabled = (actual >= total);

                let botonesHtml = '';
                for (let i = 1; i <= total; i++) {
                    const activa = (i === actual) ? 'activa' : '';
                    botonesHtml += `<button type="button" class="pag-btn ${activa}" data-pagina="${i}">${i}</button>`;
                }
                pagNumeros.innerHTML = botonesHtml;
            } else {
                paginacionRanking.style.display = 'none';
                pagInfo.style.display = (totalJugadores > 0) ? 'block' : 'none';
                if (totalJugadores > 0) {
                    pagInfo.textContent = `Total: ${totalJugadores} jugadores`;
                }
            }
        }

        function cambiarTipo(nuevoTipo) {
            if (tipoActual === nuevoTipo) return;
            tipoActual = nuevoTipo;

            if (tipoActual === 'historico') {
                tabHistorico.classList.add('activa');
                tabMensual.classList.remove('activa');
                rankingFiltrosBar.style.display = 'none';
                colPuntos.textContent = 'Puntos Totales';
            } else {
                tabMensual.classList.add('activa');
                tabHistorico.classList.remove('activa');
                rankingFiltrosBar.style.display = 'flex';
                colPuntos.textContent = 'Puntos Mes';
            }

            cargarRankingAjax(1);
        }

        tabMensual.addEventListener('click', () => cambiarTipo('mensual'));
        tabHistorico.addEventListener('click', () => cambiarTipo('historico'));

        // Actualización automática al cambiar mes o año
        selectMes.addEventListener('change', () => {
            if (tipoActual === 'mensual') cargarRankingAjax(1);
        });
        selectAnio.addEventListener('change', () => {
            if (tipoActual === 'mensual') cargarRankingAjax(1);
        });

        // Paginación con AJAX
        paginacionRanking.addEventListener('click', (e) => {
            const btnPagina = e.target.closest('[data-pagina]');
            if (btnPagina) {
                const pag = parseInt(btnPagina.getAttribute('data-pagina'), 10);
                if (!isNaN(pag) && pag !== paginaActual) {
                    cargarRankingAjax(pag);
                }
                return;
            }

            if (e.target.closest('#pagAnterior') && paginaActual > 1) {
                cargarRankingAjax(paginaActual - 1);
                return;
            }

            if (e.target.closest('#pagSiguiente') && paginaActual < totalPaginas) {
                cargarRankingAjax(paginaActual + 1);
                return;
            }
        });
    });
</script>