<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white text-center py-3 border-0">
                    <h3 class="fw-bold mb-0">Registro de Jugador</h3>
                </div>

                <div class="card-body p-4 p-md-5 bg-white text-dark">

                    {{#error}}
                        <div class="alert alert-danger text-center fw-semibold py-2">
                            {{error}}
                        </div>
                    {{/error}}

                    <form action="/Preguntados/registro/registrar" method="POST" enctype="multipart/form-data">

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control rounded-3" id="nombre_completo" name="nombre_completo" value="{{nombre_completo}}" placeholder="Nombre completo" required>
                            <label for="nombre_completo">Nombre completo</label>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <input type="number" class="form-control rounded-3" id="anio_nacimiento" name="anio_nacimiento" value="{{anio_nacimiento}}" placeholder="Año" min="1920" max="2026" required>
                                    <label for="anio_nacimiento">Año de nacimiento</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <select class="form-select rounded-3" id="sexo" name="sexo" required>
                                        <option value="" selected disabled>Seleccionar...</option>
                                        <option value="Masculino">Masculino</option>
                                        <option value="Femenino">Femenino</option>
                                        <option value="Prefiero no cargarlo">Prefiero no cargarlo</option>
                                    </select>
                                    <label for="sexo">Sexo</label>
                                </div>
                            </div>
                        </div>

                        <div class="p-3 bg-light rounded-3 border mb-3">
                            <label class="form-label fw-bold text-secondary small text-uppercase mb-2">Ubicación (Seleccioná en el mapa)</label>

                            <div id="ubicacion-alerta" class="small text-muted mb-2">
                                📍 Hacé click en tu ciudad en el mapa para marcarla.
                            </div>
                            <div id="mapa" class="rounded border mb-3" style="height: 250px; width: 100%;"></div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="text" class="form-control" id="pais" name="pais" value="{{pais}}" placeholder="País" readonly required>
                                </div>
                                <div class="col-6">
                                    <input type="text" class="form-control" id="ciudad" name="ciudad" value="{{ciudad}}" placeholder="Ciudad" readonly required>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control rounded-3" id="mail" name="mail" value="{{mail}}" placeholder="Correo" required>
                                    <label for="mail">Correo electrónico</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control rounded-3" id="username" name="username" value="{{username}}" placeholder="Usuario" required>
                                    <label for="username">Nombre de usuario</label>
                                </div>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <input type="password" class="form-control rounded-3" id="password" name="password" placeholder="Contraseña" required>
                                    <label for="password">Contraseña</label>
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <div class="form-floating">
                                    <input type="password" class="form-control rounded-3" id="repetir_password" name="repetir_password" placeholder="Repetir contraseña" required>
                                    <label for="repetir_password">Repetir contraseña</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label for="foto_perfil" class="form-label fw-semibold text-secondary small text-uppercase">Foto de perfil</label>
                            <input class="form-control" type="file" id="foto_perfil" name="foto_perfil" accept="image/*" required>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-3 shadow-sm">
                            Registrarse
                        </button>
                    </form>

                </div>

                <div class="card-footer bg-light text-center py-3 border-0">
                    <span class="text-muted">¿Ya tienes cuenta?</span>
                    <a href="/login" class="text-primary fw-bold text-decoration-none ms-1">Inicia sesión</a>
                </div>

            </div>

        </div>
    </div>
</div>
<script>
    const map = L.map('mapa').setView([-34.6037, -58.3816], 4);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap'
    }).addTo(map);

    let marker;

    map.on('click', function(e) {
        const lat = e.latlng.lat;
        const lng = e.latlng.lng;

        if (marker) {
            marker.setLatLng(e.latlng);
        } else {
            marker = L.marker(e.latlng).addTo(map);
        }

        const alerta = document.getElementById('ubicacion-alerta');
        alerta.innerText = "⏳ Buscando ubicación...";

        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.address) {
                        const pais = data.address.country || 'Desconocido';
                        const ciudad = data.address.city || data.address.town || data.address.village || data.address.state || 'Desconocida';

                        document.getElementById('pais').value = pais;
                        document.getElementById('ciudad').value = ciudad;

                        alerta.innerText = `✓ Ubicación seleccionada: ${ciudad}, ${pais}`;
                    }
                })
                .catch(() => {
                    alerta.innerText = "⚠️ Error al detectar la ciudad. Volvé a hacer click.";
                });
    });
</script>