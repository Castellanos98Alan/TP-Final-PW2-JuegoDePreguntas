<style>
    .login-container {
        width: 100%;
        max-width: 440px;
        padding: 38px 36px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.35);
    }

    .emblem {
        width: 54px;
        height: 54px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #D4AF55;
        border-radius: 50%;
        color: #F1CD73;
        font-size: 29px;
    }

    .login-container h1 {
        margin: 0;
        text-align: center;
        color: #F1CD73;
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(30px, 7vw, 42px);
        font-weight: 400;
        line-height: 1.2;
        text-shadow: 0 2px 16px rgba(212, 175, 85, 0.12);
    }

    .edition {
        margin: 10px 0 0;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        color: #DCE6F8;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 4px;
    }

    .edition::before,
    .edition::after {
        content: "";
        width: 32px;
        height: 1px;
        background: #D4AF55;
    }

    .subtitle {
        margin: 20px 0 30px;
        color: #B6C9E6;
        text-align: center;
        font-size: 14px;
        line-height: 1.6;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .login-container label {
        display: block;
        margin-bottom: 9px;
        color: #F1CD73;
        font-size: 14px;
        font-weight: 600;
    }

    .login-container input {
        width: 100%;
        padding: 14px 15px;
        border: 1px solid #315B91;
        border-radius: 9px;
        outline: none;
        background: rgba(16, 39, 73, 0.75);
        color: #FFFFFF;
        font-family: inherit;
        font-size: 14px;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .login-container input::placeholder {
        color: #88A5CD;
    }

    .login-container input:focus {
        border-color: #D4AF55;
        box-shadow: 0 0 0 3px rgba(212, 175, 85, 0.12);
    }

    .login-container button {
        width: 100%;
        margin-top: 5px;
        padding: 15px;
        border: 1px solid #F5D78A;
        border-radius: 9px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-family: inherit;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 1.5px;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .login-container button:hover {
        filter: brightness(1.08);
        transform: translateY(-2px);
    }

    .login-container button:focus-visible {
        outline: 2px solid #FFFFFF;
        outline-offset: 4px;
    }

    .error {
        padding: 12px;
        margin: 0 0 20px;
        border: 1px solid #8B414D;
        border-radius: 8px;
        background: rgba(105, 34, 49, 0.25);
        color: #FFB5BD;
        text-align: center;
        font-size: 13px;
        line-height: 1.5;
    }

    .mensaje-info {
        padding: 12px;
        margin: 0 0 20px;
        border: 1px solid #315B91;
        border-radius: 8px;
        background: rgba(31, 91, 160, 0.25);
        color: #B6C9E6;
        text-align: center;
        font-size: 13px;
        line-height: 1.5;
    }

    .mensaje-exito {
        padding: 12px;
        margin: 0 0 20px;
        border: 1px solid #2E7D32;
        border-radius: 8px;
        background: rgba(46, 125, 50, 0.25);
        color: #A5D6A7;
        text-align: center;
        font-size: 13px;
        line-height: 1.5;
    }

    .card-footer-text {
        margin: 28px 0 0;
        padding-top: 20px;
        border-top: 1px solid rgba(58, 86, 128, 0.45);
        color: #86A6D3;
        text-align: center;
        font-size: 10px;
        letter-spacing: 2px;
        line-height: 1.8;
    }

    .card-footer-text span {
        display: block;
        margin-bottom: 8px;
        color: #D4AF55;
        font-size: 19px;
    }

    @media (max-width: 480px) {
        .login-container {
            padding: 30px 23px 24px;
        }

        .subtitle {
            margin-bottom: 25px;
        }
    }
</style>

<div class="login-container">
    <div class="emblem" aria-hidden="true">✦</div>

    <h1>PREGUNTADOS</h1>
    <p class="edition">ANIME EDITION</p>
    <p class="subtitle">Demostrá cuánto sabés de anime.</p>

    {{#registro_pendiente}}
        <p class="mensaje-info" role="alert" style="font-size: 14px; padding: 18px; line-height: 1.6;">
            📩 <strong>¡Registro casi listo!</strong><br><br>
            Te hemos enviado un correo de validación a tu casilla.<br>
            Abre tu mail y haz clic en el enlace para habilitar tu cuenta.
        </p>
    {{/registro_pendiente}}

    {{^registro_pendiente}}
        {{#cuenta_activada}}
            <p class="mensaje-exito" role="alert">
                ✅ <strong>¡Cuenta activada con éxito!</strong><br>
                Ya puedes iniciar sesión.
            </p>
        {{/cuenta_activada}}

        {{#login_error}}
            <p class="error" role="alert">Usuario o contraseña incorrectos.</p>
        {{/login_error}}

        <form action="?controller=login&method=login" method="POST">
            <div class="form-group">
                <label for="usuario">Usuario</label>
                <input
                        id="usuario"
                        type="text"
                        name="usuario"
                        placeholder="Ingresá tu usuario"
                        autocomplete="username"
                        required
                >
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input
                        id="password"
                        type="password"
                        name="password"
                        placeholder="Ingresá tu contraseña"
                        autocomplete="current-password"
                        required
                >
            </div>

            <button type="submit">INICIAR SESIÓN&nbsp; →</button>
        </form>
    {{/registro_pendiente}}

    <p class="card-footer-text">
        <span aria-hidden="true">✦</span>
        EL CONOCIMIENTO TAMBIÉN ES PODER
    </p>
</div>