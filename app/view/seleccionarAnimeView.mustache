<style>
    .seleccion-anime-container {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #B98B3B;
        border-radius: 20px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
        color: #F3F5FA;
    }
    .seleccion-anime-container h1 {
        text-align: center;
        font-family: 'Permanent Marker', cursive;
        color: #F1CD73;
        font-size: clamp(28px, 5vw, 38px);
        margin-bottom: 8px;
        letter-spacing: 1px;
        text-shadow: 0 2px 16px rgba(212, 175, 85, 0.2);
    }
    .seleccion-anime-container p {
        text-align: center;
        color: #B6C9E6;
        font-size: 15px;
        margin-bottom: 25px;
    }
    /* Mensajes de error con estilo anime */
    .mensaje-error {
        max-width: 600px;
        margin: 0 auto 25px;
        padding: 12px 20px;
        border: 1px solid #8B414D;
        border-radius: 9px;
        background: rgba(105, 34, 49, 0.35);
        color: #FFB5BD;
        text-align: center;
        font-size: 14px;
        font-weight: 500;
    }
    /* Cuadrícula de Cartas */
    .animes-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
        gap: 22px;
        margin-bottom: 35px;
    }
    /* Carta individual de Anime */
    .anime-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: linear-gradient(145deg, #071936, #0d2856);
        border: 2px solid #315B91;
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        user-select: none;
        transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .anime-card:hover {
        transform: translateY(-4px);
        border-color: #D4AF55;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 12px rgba(212, 175, 85, 0.25);
    }
    /* Escondemos el checkbox original */
    .anime-checkbox {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }
    /* Imagen de portada de la carta */
    .anime-imagen-wrapper {
        position: relative;
        width: 100%;
        height: 180px;
        background: #050f21;
        overflow: hidden;
    }
    .anime-imagen {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s ease;
    }
    .anime-card:hover .anime-imagen {
        transform: scale(1.05);
    }
    /* Gradiente sobre la imagen para resaltar texto */
    .anime-imagen-wrapper::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(to bottom, transparent 60%, rgba(7, 20, 42, 0.95));
        pointer-events: none;
    }
    /* Nombre del Anime */
    .anime-nombre {
        padding: 14px 12px;
        text-align: center;
        font-weight: 700;
        font-size: 15px;
        color: #DCE6F8;
        letter-spacing: 0.5px;
        transition: color 0.2s ease;
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    /* Indicador tipo medalla (Checkmark badge) */
    .card-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(7, 20, 42, 0.85);
        border: 1.5px solid #315B91;
        color: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: bold;
        z-index: 2;
        transition: all 0.2s ease;
    }
    /* ESTADO SELECCIONADO (cuando el checkbox está marcado) */
    .anime-card:has(.anime-checkbox:checked) {
        border-color: #F1CD73;
        background: linear-gradient(145deg, #0e2752, #163e7c);
        box-shadow: 0 0 20px rgba(241, 205, 115, 0.38), 0 8px 24px rgba(0, 0, 0, 0.4);
        transform: translateY(-6px) scale(1.02);
    }
    .anime-card:has(.anime-checkbox:checked) .anime-nombre {
        color: #F1CD73;
    }
    .anime-card:has(.anime-checkbox:checked) .card-badge {
        background: #F1CD73;
        border-color: #F5D78A;
        color: #0A1A33;
        box-shadow: 0 0 8px rgba(241, 205, 115, 0.6);
    }
    /* Barra de Botones Inferior */
    .acciones-partida {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        padding-top: 15px;
        border-top: 1px solid rgba(58, 86, 128, 0.45);
    }
    .btn-volver {
        text-decoration: none;
        padding: 13px 26px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.5px;
        border: 1px solid #315B91;
        color: #DCE6F8;
        background: rgba(16, 39, 73, 0.45);
        transition: all 0.2s ease;
    }
    .btn-volver:hover {
        border-color: #D4AF55;
        color: #F1CD73;
        transform: translateY(-2px);
    }
    .btn-comenzar {
        padding: 13px 34px;
        border-radius: 8px;
        border: 1px solid #F5D78A;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 1px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(212, 175, 85, 0.3);
        transition: all 0.2s ease;
    }
    .btn-comenzar:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(212, 175, 85, 0.45);
    }
</style>
<div class="seleccion-anime-container">

    <h1>Elegí tus animes</h1>

    <p>
        Podés seleccionar uno o varios animes para la partida.
    </p>

    {{#errorSeleccion}}
        <div class="mensaje-error">
            Tenés que seleccionar al menos un anime.
        </div>
    {{/errorSeleccion}}

    {{#errorPreguntas}}
        <div class="mensaje-error">
            No hay suficientes preguntas para los animes seleccionados.
        </div>
    {{/errorPreguntas}}

    <form
        action="?controller=partida&method=nueva"
        method="POST"
    >

        <div class="animes-grid">
            {{#animes}}
                <label class="anime-card">
                    <input type="checkbox" name="animes[]" value="{{id}}" class="anime-checkbox">

                    <div class="card-badge">✓</div>

                    <div class="anime-imagen-wrapper">
                        {{#imagen}}
                            <img src="{{imagen}}" alt="{{nombre}}" class="anime-imagen">
                        {{/imagen}}
                    </div>

                    <span class="anime-nombre">{{nombre}}</span>
                </label>
            {{/animes}}
        </div>

        <div class="acciones-partida">

            <a
                href="?controller=lobby&method=index"
                class="btn-volver"
            >
                Volver
            </a>

            <button
                type="submit"
                class="btn-comenzar"
            >
                Comenzar partida
            </button>

        </div>

    </form>

</div>