<style>
    * {
        box-sizing: border-box;
    }

    .editor-container {
        width: 92%;
        max-width: 1100px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #3B82F6;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(59, 130, 246, 0.35);
    }

    .editor-title {
        color: #60A5FA;
        font-size: 26px;
        font-weight: 700;
        margin: 0;
    }

    .btn-gold {
        padding: 8px 16px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
    }

    .section-card {
        background: rgba(16, 39, 73, 0.45);
        border: 1px solid #315B91;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .section-title {
        color: #F1CD73;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th {
        background: rgba(16, 39, 73, 0.95);
        color: #60A5FA;
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #315B91;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid rgba(49, 91, 145, 0.35);
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s ease;
    }

    .btn-approve {
        background: #16A34A;
        color: white;
    }

    .btn-approve:hover {
        background: #15803d;
    }

    .btn-reject {
        background: #DC2626;
        color: white;
    }

    .btn-reject:hover {
        background: #b91c1c;
    }

    .btn-edit {
        background: #2563EB;
        color: white;
    }

    .btn-edit:hover {
        background: #1d4ed8;
    }

    .form-group {
        margin-bottom: 14px;
    }

    .editor-container label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #93C5FD;
        margin-bottom: 6px;
    }

    .editor-container input[type="text"],
    .editor-container select {
        width: 100%;
        padding: 10px;
        background: rgba(10, 26, 51, 0.85);
        border: 1px solid #315B91;
        border-radius: 6px;
        color: #FFF;
        font-size: 13px;
    }

    .editor-container select option {
        background: #0A1A33;
        color: white;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .option-row input[type="radio"] {
        accent-color: #F1CD73;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .option-row input[type="text"] {
        flex: 1;
    }

    .form-help {
        color: #88A5CD;
        font-size: 11px;
        margin-top: 5px;
    }

    @media (max-width: 700px) {
        .editor-container {
            width: 100%;
            margin: 16px auto 30px;
            padding: 20px 14px;
            border-radius: 14px;
        }

        .editor-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .editor-title {
            font-size: 22px;
        }

        .section-card {
            padding: 14px;
        }
    }

    .acciones-pregunta {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .acciones-pregunta form {
        margin: 0;
    }

    /* Tabla de preguntas */
    .tabla-preguntas {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .tabla-preguntas th {
        padding: 15px;
        background: #122b4d;
        color: #72b2ff;
        text-align: left;
        font-size: 13px;
    }

    .tabla-preguntas td {
        padding: 14px;
        border-bottom: 1px solid #254469;
        color: #e5edff;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    /* Efecto cuando pasamos el mouse */
    .tabla-preguntas tbody tr {
        transition: background 0.2s ease;
    }

    .tabla-preguntas tbody tr:hover {
        background: rgba(60, 120, 200, 0.15);
    }

    /* Botones alineados */
    .acciones-pregunta {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

    .acciones-pregunta form {
        margin: 0;
    }

    /* Estilo compartido */
    .acciones-pregunta .btn-edit,
    .btn-desactivar,
    .btn-reactivar {
        padding: 9px 13px;
        border-radius: 7px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    /* Editar */
    .acciones-pregunta .btn-edit {
        background: #2563eb;
        color: white;
    }

    /* Desactivar */
    .btn-desactivar {
        background: #a43832;
        color: white;
    }

    /* Reactivar */
    .btn-reactivar {
        background: #168653;
        color: white;
    }

    /* Hover de los botones */
    .acciones-pregunta .btn-edit:hover,
    .btn-desactivar:hover,
    .btn-reactivar:hover {
        filter: brightness(1.2);
        transform: translateY(-2px);
    }


    .paginacion {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-pagina {
        padding: 10px 18px;
        background: #17365d;
        border: 1px solid #d4af55;
        border-radius: 8px;
        color: #f1cd73;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.2s ease;
    }

    .btn-pagina:hover {
        background: #d4af55;
        color: #0a1a33;
    }

    .paginacion span {
        color: #a9c2e8;
        font-size: 13px;
    }

    .paginacion {
        flex-wrap: wrap;
    }

    .filtros-editor {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 20px 0;
        align-items: center;
    }

    .filtros-editor input,
    .filtros-editor select {
        padding: 11px;
        background: #0a1a33;
        border: 1px solid #315b91;
        border-radius: 8px;
        color: white;
        flex: 1 1 170px;
        min-width: 0;
    }

    .filtros-editor button,
    .btn-limpiar {
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
    }

    .filtros-editor button {
        background: #d4af55;
        color: #0a1a33;
        border: none;
    }

    .btn-limpiar {
        background: #17365d;
        color: white;
        border: 1px solid #315b91;
    }

    .filtros-editor button:hover,
    .btn-limpiar:hover {
        filter: brightness(1.15);
    }

    .badge-estado {
        display: inline-block;
        padding: 6px 10px;
        max-width: 100%;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        min-width: 120px;
    }

    .badge-activa {
        background: rgba(22, 134, 83, 0.18);
        color: #4ade80;
        border: 1px solid #168653;
    }

    .badge-inactiva {
        background: rgba(120, 130, 150, 0.18);
        color: #cbd5e1;
        border: 1px solid #64748b;
    }

    .badge-rechazada {
        background: rgba(164, 56, 50, 0.18);
        color: #f87171;
        border: 1px solid #a43832;
    }

    .badge-reportada {
        background: rgba(251, 191, 36, 0.18);
        color: #fbbf24;
        border: 1px solid #f59e0b;
    }

    .btn-gold {
        padding: 9px 18px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .btn-print {
        background: transparent;
        color: #F1CD73;
        border: 1px solid #D4AF55;
    }

    .btn-print:hover {
        background: #D4AF55;
        color: #0A1A33;
    }

    /* ===== RESPONSIVE ===== */

    /* Red de seguridad: si una tabla igual no entra, scrollea ADENTRO de su tarjeta, no la página */
    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .celda-acciones {
        text-align: center;
    }

    .tabla-vacia {
        text-align: center;
        color: #88A5CD;
        padding: 20px;
    }

    @media (max-width: 600px) {
        .section-title {
            font-size: 14px;
        }

        .option-row {
            gap: 10px;
        }

        .option-row input[type="radio"] {
            width: 22px;
            height: 22px;
        }

        /* filtros: campos a todo el ancho, botones lado a lado */
        .filtros-editor input,
        .filtros-editor select {
            flex: 1 1 100%;
        }

        .filtros-editor button {
            flex: 1 1 calc(50% - 5px);
            min-height: 42px;
        }

        .section-card .btn-approve[type="submit"] {
            width: 100%;
        }
    }

    /* Tablas -> tarjetas (una por fila). Solo en pantalla: la impresión sigue siendo tabla */
    @media screen and (max-width: 900px) {
        .tabla-responsive,
        .tabla-responsive tbody,
        .tabla-responsive tr,
        .tabla-responsive td {
            display: block;
            width: 100%;
        }

        /* encabezado oculto visualmente pero disponible para lectores de pantalla */
        .tabla-responsive thead {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip: rect(0 0 0 0);
            white-space: nowrap;
        }

        .tabla-responsive tr {
            margin-bottom: 14px;
            padding: 4px 0;
            background: rgba(10, 26, 51, 0.55);
            border: 1px solid #315B91;
            border-radius: 10px;
        }

        .tabla-responsive tbody tr:hover {
            background: rgba(10, 26, 51, 0.55);
        }

        .tabla-responsive td {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding: 10px 14px;
            border-bottom: 1px solid rgba(49, 91, 145, 0.25);
            text-align: right;
            overflow-wrap: anywhere;
        }

        .tabla-responsive td:last-child {
            border-bottom: 0;
        }

        .tabla-responsive td::before {
            content: attr(data-label);
            flex: 0 0 34%;
            max-width: 34%;
            text-align: left;
            color: #93C5FD;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* fila vacía ("No hay ...") */
        .tabla-responsive td:not([data-label]) {
            display: block;
            text-align: center;
        }

        .tabla-responsive td:not([data-label])::before {
            content: none;
        }

        /* enunciado y acciones: etiqueta arriba, contenido debajo a todo el ancho */
        .tabla-responsive td.celda-principal,
        .tabla-responsive td.celda-acciones {
            flex-direction: column;
            align-items: stretch;
            text-align: left;
        }

        .tabla-responsive td.celda-principal::before,
        .tabla-responsive td.celda-acciones::before {
            flex: none;
            max-width: none;
        }

        .tabla-responsive .acciones-pregunta {
            justify-content: flex-start;
        }

        .badge-estado {
            min-width: 0;
        }

        /* botones de acción: área táctil cómoda */
        .btn-action,
        .btn-desactivar,
        .btn-reactivar,
        .acciones-pregunta .btn-edit {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
        }
    }

    .categorias-subtitulo {
        color: #93A9C7;
        font-size: 14px;
        margin-bottom: 22px;
    }

    .categoria-nueva {
