    /* revision de preguntas sugeridas*/

    /* ========================================
   MODAL DE REVISIÓN DE PREGUNTAS
======================================== */

    .modal-revision {
        position: fixed;
        inset: 0;
        margin: auto;
        box-sizing: border-box;
        width: 600px;
        max-width: 90vw;
        max-height: 85vh;
        overflow-y: auto;
        padding: 25px;
        background: #0d1f37;
        color: #fff;
        border: 1px solid #D4AF55;
        border-radius: 16px;
        box-shadow: 0 0 35px rgba(0, 0, 0, 0.5);
    }

    /* Animación de apertura */

    .modal-revision[open] {
        animation: abrirRevision 0.3s ease;
    }

    @keyframes abrirRevision {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Fondo oscuro y desenfocado */

    .modal-revision::backdrop {
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(5px);
    }

    /* Cabecera del modal */

    .revision-cabecera {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #315b91;
    }

    .revision-cabecera h2 {
        color: #D4AF55;
        font-size: 21px;
        margin: 0;
    }

    /* Botón de cerrar */

    .revision-cerrar {
        background: transparent;
        color: #D4AF55;
        border: none;
        font-size: 25px;
        cursor: pointer;
        line-height: 1;
        transition: all 0.2s ease;
    }

    .revision-cerrar:hover {
        color: #fff;
        transform: scale(1.15);
    }

    /* Etiquetas de anime y categoría */

    .revision-etiquetas {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 20px;
    }

    .revision-etiquetas span {
        background: #142c4c;
        border: 1px solid #315b91;
        color: #93c5fd;
        padding: 8px 14px;
        border-radius: 20px;
        font-size: 13px;
    }

    /* Enunciado de la pregunta */

    .modal-revision h3 {
        text-align: center;
        margin: 25px 0;
        color: #fff;
        font-size: 18px;
        line-height: 1.5;
    }

    /* Imagen de la pregunta */

    .revision-imagen {
        display: block;
        max-width: 100%;
        max-height: 250px;
        object-fit: contain;
        margin: 20px auto;
        border: 1px solid #D4AF55;
        border-radius: 12px;
    }

    /* Reproductor de audio */

    .modal-revision audio {
        display: block;
        width: 100%;
        margin: 20px auto;
    }

    /* Opciones de respuesta */

    .revision-respuestas {
        display: grid;
        gap: 12px;
        margin: 20px 0;
    }

    .revision-respuestas div {
        padding: 14px;
        background: #142c4c;
        border: 1px solid #315b91;
        border-radius: 8px;
        text-align: center;
        font-size: 14px;
        transition: all 0.2s ease;
    }

    .revision-respuestas div:hover {
        background: #1c385c;
        border-color: #D4AF55;
    }

    /* Respuesta correcta */

    .revision-correcta {
        background: rgba(22, 163, 74, 0.15);
        border: 1px solid #16a34a;
        color: #86efac;
        padding: 14px;
        border-radius: 8px;
        margin: 20px 0;
        text-align: center;
        font-size: 14px;
        font-weight: bold;
    }

    /* Botones de aprobación y rechazo */

    .modal-revision .acciones-pregunta {
        display: flex;
        justify-content: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .modal-revision .acciones-pregunta form {
        margin: 0;
    }

    .modal-revision .btn-action {
        padding: 12px 22px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.25s ease;
    }

    .modal-revision .btn-approve {
        background: #16a34a;
        color: white;
    }

    .modal-revision .btn-approve:hover {
        background: #15803d;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(22, 163, 74, 0.35);
    }

    .modal-revision .btn-reject {
        background: #dc2626;
        color: white;
    }

    .modal-revision .btn-reject:hover {
        background: #b91c1c;
        transform: translateY(-2px);
        box-shadow: 0 0 15px rgba(220, 38, 38, 0.35);
    }

    /* Barra de desplazamiento */

    .modal-revision::-webkit-scrollbar {
        width: 6px;
    }

    .modal-revision::-webkit-scrollbar-track {
        background: #0d1f37;
    }

    .modal-revision::-webkit-scrollbar-thumb {
        background: #D4AF55;
        border-radius: 10px;
    }

    /* Adaptación a celulares */

    @media (max-width: 600px) {
        .modal-revision {
            width: 92vw;
            max-width: 92vw;
            padding: 18px;
        }

        .revision-cabecera h2 {
            font-size: 17px;
        }

        .modal-revision h3 {
            font-size: 16px;
        }

        .modal-revision .acciones-pregunta {
            flex-direction: column;
            gap: 10px;
        }

        .modal-revision .btn-action {
            width: 100%;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .modal-revision[open] {
            animation: none;
        }
    }


    /* estilo acordeon*/

    /* PANELES COLAPSABLES */

    .panel-cabecera {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        cursor: pointer;
        list-style: none;
        user-select: none;
    }

    .panel-cabecera::-webkit-details-marker {
        display: none;
    }

    .panel-cabecera .section-title {
        margin: 0;
    }

    /* Botón de expandir y contraer */

    .panel-icono {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        background: #142c4c;
        color: #D4AF55;
        border: 1px solid #D4AF55;
        border-radius: 8px;
        font-size: 23px;
        font-weight: bold;
        transition: all 0.25s ease;
    }

    /* Panel cerrado */

    .panel-icono::before {
        content: "+";
    }

    /* Panel abierto */

    .panel-colapsable[open] > .panel-cabecera .panel-icono::before {
        content: "−";
    }

    /* Efecto hover */

    .panel-cabecera:hover .panel-icono {
        background: #D4AF55;
        color: #091629;
        box-shadow: 0 0 12px rgba(212, 175, 85, 0.3);
    }

    /* Contenido interno */

    .panel-contenido {
        padding-top: 20px;
    }

    /* Animación de apertura */

    .panel-colapsable[open] > .panel-contenido {
        animation: expandirPanel 0.3s ease;
    }

    @keyframes expandirPanel {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

