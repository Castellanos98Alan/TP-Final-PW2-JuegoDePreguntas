        <select name="categoria_id">
            <option value="0">Todas las categorías</option>

            {{#categorias}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>
                    {{nombre}}
                </option>
            {{/categorias}}
        </select>

        <select name="estado">
            <option value="">Todos los estados</option>

            <option value="activa" {{#estadoActivo}}selected{{/estadoActivo}}>
                Activas
            </option>

            <option value="inactiva" {{#estadoInactivo}}selected{{/estadoInactivo}}>
                Inactivas
            </option>

            <option value="rechazada" {{#estadoRechazado}}selected{{/estadoRechazado}}>
                Rechazadas
            </option>

            <option value="reportada" {{#estadoReportado}}selected{{/estadoReportado}}>
                Baja por reportes
            </option>
        </select>

        <button type="submit">Buscar</button>

        <button type="submit" name="limpiar_filtros" value="1" class="btn-gold btn-print">
            Limpiar
        </button>



    </form>

    <!-- 4. EDITAR PREGUNTAS ACTIVAS -->
    <details class="section-card panel-colapsable" open>

        <summary class="panel-cabecera">

            <h2 class="section-title">
                GESTIONAR PREGUNTAS
            </h2>

            <span class="panel-icono"></span>

        </summary>

        <div class="panel-contenido">

        <div class="table-wrap">
            <table class="tabla-responsive">
                <thead>
                <tr>
                    <th style="width: 50%;">Pregunta</th>
                    <th style="width: 10%;">Categoría</th>
                    <th style="width: 15%; text-align: center">Estado</th>
                    <th style="width: 25%; text-align: center">Acciones</th>
                </tr>
                </thead>

                <tbody>
                {{#activas}}
                    <tr>
                        <td class="celda-principal" data-label="Pregunta">{{descripcion}}</td>
                        <td data-label="Categoría">{{categoria}}</td>

                        <td data-label="Estado">
                            {{#estadoActiva}}
                                <span class="badge-estado badge-activa">Activa</span>
                            {{/estadoActiva}}

                            {{#estadoInactiva}}
                                <span class="badge-estado badge-inactiva">Inactiva</span>
                            {{/estadoInactiva}}

                            {{#estadoRechazada}}
                                <span class="badge-estado badge-rechazada">Rechazada</span>
                            {{/estadoRechazada}}

                            {{#estadoReportada}}
                                <span class="badge-estado badge-reportada">Baja por reportes</span>
                            {{/estadoReportada}}
                        </td>

                        <td class="celda-acciones" data-label="Acciones">
                            <div class="acciones-pregunta">

                                {{#activa}}
                                    <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                    Editar
                                    </a>

                                    <form action="editor/desactivar" method="POST" style="display:inline;">
                                        <input type="hidden" name="id_pregunta" value="{{id}}">
                                        <button type="submit" class="btn-desactivar">
                                            Desactivar
                                        </button>
                                    </form>
                                {{/activa}}

                                {{#estadoInactiva}}
                                    <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                    Editar
                                    </a>

                                    <form action="editor/reactivar" method="POST" style="display:inline;">
                                        <input type="hidden" name="id_pregunta" value="{{id}}">
                                        <button type="submit" class="btn-reactivar">
                                            Reactivar
                                        </button>
                                    </form>
                                {{/estadoInactiva}}

                                {{#estadoReportada}}
                                    <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                    Revisar
                                    </a>
                                {{/estadoReportada}}

                                {{#estadoRechazada}}
                                    <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                    Revisar
                                    </a>

                                    <form action="editor/recuperarRechazada" method="POST" style="display:inline;">
                                        <input type="hidden" name="id_pregunta" value="{{id}}">
                                        <button type="submit" class="btn-reactivar">
                                            Aprobar y reactivar
                                        </button>
                                    </form>
                                {{/estadoRechazada}}

                            </div>
                        </td>
                    </tr>
                {{/activas}}
                </tbody>
            </table>
        </div>

        <div class="paginacion">

            {{#hayAnterior}}
                <a href="editor?pagina={{paginaAnterior}}"
                class="btn-pagina">
                Anterior
                </a>
            {{/hayAnterior}}

            <span>
        Página {{paginaActual}} de {{totalPaginas}}
    </span>

            {{#haySiguiente}}
                <a href="editor?pagina={{paginaSiguiente}}"
                class="btn-pagina">
                Siguiente
                </a>
            {{/haySiguiente}}

        </div>

    </div>

</div>

</div>

</details>

<script>
    const botonesMedia = document.querySelectorAll('.editor-media-btn');
    const tipoPregunta = document.getElementById('editorTipoPregunta');
    const contenedorArchivo = document.getElementById('editorMediaArchivo');
    const archivo = document.getElementById('editorRecurso');
    const previewImagen = document.getElementById('editorPreviewImagen');
    const previewAudio = document.getElementById('editorPreviewAudio');
    const mediaLabel = document.getElementById('editorMediaLabel');

    let urlPreview = null;

    function limpiarPreview() {
        previewAudio.pause();

        previewImagen.hidden = true;
        previewAudio.hidden = true;

        previewImagen.removeAttribute('src');
        previewAudio.removeAttribute('src');
        previewAudio.load();

        if (urlPreview) {
            URL.revokeObjectURL(urlPreview);
            urlPreview = null;
        }
    }

    botonesMedia.forEach(boton => {

        boton.addEventListener('click', () => {

            botonesMedia.forEach(b => {
                b.classList.remove('seleccionado');
            });

            boton.classList.add('seleccionado');

            const tipo = boton.dataset.tipo;

            tipoPregunta.value = tipo;

            archivo.value = '';
            limpiarPreview();

            contenedorArchivo.hidden = tipo === 'texto';
            archivo.disabled = tipo === 'texto';
            archivo.required = tipo !== 'texto';

            if (tipo === 'imagen') {
                archivo.accept = '.jpg,.jpeg,.png,.webp';
                mediaLabel.textContent = 'Seleccionar imagen:';
            }

            if (tipo === 'audio') {
                archivo.accept = '.mp3,.wav,.ogg';
                mediaLabel.textContent = 'Seleccionar audio:';
            }
        });
    });

    archivo.addEventListener('change', () => {

        limpiarPreview();

        const seleccionado = archivo.files[0];

        if (!seleccionado) return;

        if (seleccionado.size > 5 * 1024 * 1024) {
            alert('El archivo no puede superar los 5 MB.');
            archivo.value = '';
            return;
        }

        urlPreview = URL.createObjectURL(seleccionado);

        if (tipoPregunta.value === 'imagen') {
            previewImagen.src = urlPreview;
            previewImagen.hidden = false;
        }

        if (tipoPregunta.value === 'audio') {
            previewAudio.src = urlPreview;
            previewAudio.hidden = false;
        }
    });
</script>
