<style>
    * {
        box-sizing: border-box;
    }

    .editor-container {
        width: 92%;
        max-width: 1100px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #3B82F6;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(59, 130, 246, 0.35);
    }

    .editor-title {
        color: #60A5FA;
        font-size: 26px;
        font-weight: 700;
        margin: 0;
    }

    .btn-gold {
        padding: 8px 16px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
    }

    .section-card {
        background: rgba(16, 39, 73, 0.45);
        border: 1px solid #315B91;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .section-title {
        color: #F1CD73;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th {
        background: rgba(16, 39, 73, 0.95);
        color: #60A5FA;
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #315B91;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid rgba(49, 91, 145, 0.35);
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s ease;
    }

    .btn-approve {
        background: #16A34A;
        color: white;
    }

    .btn-approve:hover {
        background: #15803d;
    }

    .btn-reject {
        background: #DC2626;
        color: white;
    }

    .btn-reject:hover {
        background: #b91c1c;
    }

    .btn-edit {
        background: #2563EB;
        color: white;
    }

    .btn-edit:hover {
        background: #1d4ed8;
    }

    .form-group {
        margin-bottom: 14px;
    }

    .editor-container label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #93C5FD;
        margin-bottom: 6px;
    }

    .editor-container input[type="text"],
    .editor-container select {
        width: 100%;
        padding: 10px;
        background: rgba(10, 26, 51, 0.85);
        border: 1px solid #315B91;
        border-radius: 6px;
        color: #FFF;
        font-size: 13px;
    }

    .editor-container select option {
        background: #0A1A33;
        color: white;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .option-row input[type="radio"] {
        accent-color: #F1CD73;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .option-row input[type="text"] {
        flex: 1;
    }

    .form-help {
        color: #88A5CD;
        font-size: 11px;
        margin-top: 5px;
    }

    @media (max-width: 700px) {
        .editor-container {
            width: 96%;
            padding: 20px 14px;
        }

        .editor-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .section-card {
            padding: 14px;
            overflow-x: auto;
        }

        table {
            min-width: 600px;
        }
    }

    .acciones-pregunta {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .acciones-pregunta form {
        margin: 0;
    }

    /* Tabla de preguntas */
    .tabla-preguntas {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
    }

    .tabla-preguntas th {
        padding: 15px;
        background: #122b4d;
        color: #72b2ff;
        text-align: left;
        font-size: 13px;
    }

    .tabla-preguntas td {
        padding: 14px;
        border-bottom: 1px solid #254469;
        color: #e5edff;
        font-size: 13px;
        overflow-wrap: anywhere;
    }

    /* Efecto cuando pasamos el mouse */
    .tabla-preguntas tbody tr {
        transition: background 0.2s ease;
    }

    .tabla-preguntas tbody tr:hover {
        background: rgba(60, 120, 200, 0.15);
    }

    /* Botones alineados */
    .acciones-pregunta {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

    .acciones-pregunta form {
        margin: 0;
    }

    /* Estilo compartido */
    .acciones-pregunta .btn-edit,
    .btn-desactivar,
    .btn-reactivar {
        padding: 9px 13px;
        border-radius: 7px;
        border: none;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    /* Editar */
    .acciones-pregunta .btn-edit {
        background: #2563eb;
        color: white;
    }

    /* Desactivar */
    .btn-desactivar {
        background: #a43832;
        color: white;
    }

    /* Reactivar */
    .btn-reactivar {
        background: #168653;
        color: white;
    }

    /* Hover de los botones */
    .acciones-pregunta .btn-edit:hover,
    .btn-desactivar:hover,
    .btn-reactivar:hover {
        filter: brightness(1.2);
        transform: translateY(-2px);
    }


    .paginacion {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 15px;
        margin-top: 25px;
    }

    .btn-pagina {
        padding: 10px 18px;
        background: #17365d;
        border: 1px solid #d4af55;
        border-radius: 8px;
        color: #f1cd73;
        text-decoration: none;
        font-weight: bold;
        transition: all 0.2s ease;
    }

    .btn-pagina:hover {
        background: #d4af55;
        color: #0a1a33;
    }

    .paginacion span {
        color: #a9c2e8;
        font-size: 13px;
    }

    .filtros-editor {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin: 20px 0;
        align-items: center;
    }

    .filtros-editor input,
    .filtros-editor select {
        padding: 11px;
        background: #0a1a33;
        border: 1px solid #315b91;
        border-radius: 8px;
        color: white;
        flex: 1 1 170px;
        min-width: 0;
    }

    .filtros-editor button,
    .btn-limpiar {
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: bold;
        cursor: pointer;
        text-decoration: none;
    }

    .filtros-editor button {
        background: #d4af55;
        color: #0a1a33;
        border: none;
    }

    .btn-limpiar {
        background: #17365d;
        color: white;
        border: 1px solid #315b91;
    }

    .filtros-editor button:hover,
    .btn-limpiar:hover {
        filter: brightness(1.15);
    }

    .badge-estado {
        display: inline-block;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        min-width: 120px;
    }

    .badge-activa {
        background: rgba(22, 134, 83, 0.18);
        color: #4ade80;
        border: 1px solid #168653;
    }

    .badge-inactiva {
        background: rgba(120, 130, 150, 0.18);
        color: #cbd5e1;
        border: 1px solid #64748b;
    }

    .badge-rechazada {
        background: rgba(164, 56, 50, 0.18);
        color: #f87171;
        border: 1px solid #a43832;
    }

    .badge-reportada {
        background: rgba(251, 191, 36, 0.18);
        color: #fbbf24;
        border: 1px solid #f59e0b;
    }

    .btn-gold {
        padding: 9px 18px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-decoration: none;
        display: inline-block;
        cursor: pointer;
        transition: transform 0.2s, filter 0.2s;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-2px);
    }

    .btn-print {
        background: transparent;
        color: #F1CD73;
        border: 1px solid #D4AF55;
    }

    .btn-print:hover {
        background: #D4AF55;
        color: #0A1A33;
    }


</style>

<div class="editor-container">

    <div class="editor-header">
        <div>
            <h1 class="editor-title">PANEL DE EDICIÓN</h1>
            <span style="font-size: 12px; color: #93C5FD;">
                Sesión iniciada como: {{username}}
            </span>
        </div>

        <a href="lobby" class="btn-gold">
            ← VOLVER AL LOBBY
        </a>
    </div>

    <!-- 1. REPORTES DE PREGUNTAS -->
    <div class="section-card">
        <div class="section-title">REPORTES DE PREGUNTAS</div>


        <table class="tabla-preguntas">
            <thead>
            <tr>
                <th style="width: 45%;">Pregunta reportada</th>
                <th>Categoría</th>
                <th>Reportes</th>
                <th style="text-align: center;">Acciones</th>
            </tr>
            </thead>

            <tbody>
            {{#preguntas_baja_reportes}}
                <tr>
                    <td>
                        <strong>{{descripcion}}</strong>
                    </td>

                    <td>{{categoria}}</td>

                    <td>
                <span class="cantidad-reportes">
                    {{cantidad_reportes}} reportes
                </span>
                    </td>

                    <td style="text-align: center;">
                        <a href="editor/editar?id={{id}}"
                        class="btn-action btn-edit">
                        Revisar pregunta
                        </a>
                    </td>
                </tr>
            {{/preguntas_baja_reportes}}

            {{^preguntas_baja_reportes}}
                <tr>
                    <td colspan="4"
                        style="text-align: center; color: #88A5CD; padding: 20px;">
                        No hay preguntas dadas de baja por reportes.
                    </td>
                </tr>
            {{/preguntas_baja_reportes}}
            </tbody>
        </table>
    </div>

    <!-- 2. PREGUNTAS PENDIENTES -->
    <div class="section-card">
        <div class="section-title">
            REVISAR PREGUNTAS NUEVAS (SUGERIDAS)
        </div>

        <table>
            <thead>
                <tr>
                    <th>Pregunta</th>
                    <th>Categoría</th>
                    <th>Creador</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                {{#pendientes}}
                <tr>
                    <td>{{descripcion}}</td>
                    <td>{{categoria}}</td>
                    <td>{{creador}}</td>

                    <td style="text-align: center;">
                        <form action="editor/aprobar"
                              method="POST"
                              style="display:inline;">

                            <input type="hidden" name="id" value="{{id}}">

                            <button type="submit" class="btn-action btn-approve">
                                Aprobar
                            </button>
                        </form>

                        <form action="editor/rechazar"
                              method="POST"
                              style="display:inline; margin-left: 5px;">

                            <input type="hidden" name="id" value="{{id}}">

                            <button type="submit" class="btn-action btn-reject">
                                Rechazar
                            </button>
                        </form>
                    </td>
                </tr>
                {{/pendientes}}

                {{^pendientes}}
                <tr>
                    <td colspan="4" style="text-align: center; color: #88A5CD; padding: 16px;">
                        No hay preguntas pendientes de revisión.
                    </td>
                </tr>
                {{/pendientes}}
            </tbody>
        </table>
    </div>

    <!-- 3. AGREGAR NUEVA PREGUNTA -->
    <div class="section-card">
        <div class="section-title">AGREGAR NUEVA PREGUNTA</div>

        <form action="editor/guardar" method="POST">

            <div class="form-group">
                <label for="descripcion">Enunciado de la pregunta:</label>

                <input
                    type="text"
                    id="descripcion"
                    name="descripcion"
                    placeholder="Ej: ¿Quién es el capitán de la tripulación de Sombrero de Paja?"
                    maxlength="500"
                    required
                >
            </div>

            <div class="form-group">
                <label for="anime_id">Anime:</label>

                <select name="anime_id" id="anime_id" required>
                    <option value="">Seleccionar anime</option>

                    {{#animes}}
                    <option value="{{id}}">{{nombre}}</option>
                    {{/animes}}
                </select>
            </div>

            <div class="form-group">
                <label for="categoria_id">Categoría:</label>

                <select name="categoria_id" id="categoria_id" required>
                    <option value="">Seleccionar categoría</option>

                    {{#categorias}}
                    <option value="{{id}}">{{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <label style="margin-top: 15px;">
                Opciones de respuesta (Marcá la opción correcta):
            </label>

            <div class="option-row">
                <input type="radio" name="correcta" value="0" checked>
                <input type="text" name="opciones[]" placeholder="Opción A" maxlength="255" required>
            </div>

            <div class="option-row">
                <input type="radio" name="correcta" value="1">
                <input type="text" name="opciones[]" placeholder="Opción B" maxlength="255" required>
            </div>

            <div class="option-row">
                <input type="radio" name="correcta" value="2">
                <input type="text" name="opciones[]" placeholder="Opción C" maxlength="255" required>
            </div>

            <div class="option-row">
                <input type="radio" name="correcta" value="3">
                <input type="text" name="opciones[]" placeholder="Opción D" maxlength="255" required>
            </div>

            <p class="form-help">
                La pregunta se guardará como pendiente hasta que un editor o administrador la apruebe.
            </p>

            <button type="submit"
                    class="btn-action btn-approve"
                    style="margin-top: 12px; padding: 10px 20px; font-size: 13px;">
                Guardar Pregunta
            </button>

        </form>
    </div>

    <form action="editor" method="POST" class="filtros-editor">

        <input type="text"
               name="busqueda"
               placeholder="Buscar pregunta..."
               value="{{busqueda}}">

        <select name="anime_id">
            <option value="0">Todos los animes</option>

            {{#animes}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>
                    {{nombre}}
                </option>
            {{/animes}}
        </select>

        <select name="categoria_id">
            <option value="0">Todas las categorías</option>

            {{#categorias}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>
                    {{nombre}}
                </option>
            {{/categorias}}
        </select>

        <select name="estado">
            <option value="">Todos los estados</option>

            <option value="activa" {{#estadoActivo}}selected{{/estadoActivo}}>
                Activas
            </option>

            <option value="inactiva" {{#estadoInactivo}}selected{{/estadoInactivo}}>
                Inactivas
            </option>

            <option value="rechazada" {{#estadoRechazado}}selected{{/estadoRechazado}}>
                Rechazadas
            </option>

            <option value="reportada" {{#estadoReportado}}selected{{/estadoReportado}}>
                Baja por reportes
            </option>
        </select>

        <button type="submit">Buscar</button>

        <button type="submit" name="limpiar_filtros" value="1" class="btn-gold btn-print">
            Limpiar
        </button>



    </form>

    <!-- 4. EDITAR PREGUNTAS ACTIVAS -->
    <div class="section-card">
        <div class="section-title">GESTIONAR PREGUNTAS</div>

        <table>
            <thead>
                <tr>
                    <thead>
                <tr>
                    <th style="width: 50%;">Pregunta</th>
                    <th style="width: 10%;">Categoría</th>
                    <th style="width: 15%; text-align: center">Estado</th>
                    <th style="width: 25%; text-align: center">Acciones</th>
                </tr>
            </thead>

                </tr>
            </thead>

            <tbody>
            {{#activas}}
                <tr>
                    <td>{{descripcion}}</td>
                    <td>{{categoria}}</td>

                    <td>
                        {{#estadoActiva}}
                            <span class="badge-estado badge-activa">Activa</span>
                        {{/estadoActiva}}

                        {{#estadoInactiva}}
                            <span class="badge-estado badge-inactiva">Inactiva</span>
                        {{/estadoInactiva}}

                        {{#estadoRechazada}}
                            <span class="badge-estado badge-rechazada">Rechazada</span>
                        {{/estadoRechazada}}

                        {{#estadoReportada}}
                            <span class="badge-estado badge-reportada">Baja por reportes</span>
                        {{/estadoReportada}}
                    </td>

                    <td>
                        <div class="acciones-pregunta">

                            {{#activa}}
                                <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                Editar
                                </a>

                                <form action="editor/desactivar" method="POST" style="display:inline;">
                                    <input type="hidden" name="id_pregunta" value="{{id}}">
                                    <button type="submit" class="btn-desactivar">
                                        Desactivar
                                    </button>
                                </form>
                            {{/activa}}

                            {{#estadoInactiva}}
                                <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                Editar
                                </a>

                                <form action="editor/reactivar" method="POST" style="display:inline;">
                                    <input type="hidden" name="id_pregunta" value="{{id}}">
                                    <button type="submit" class="btn-reactivar">
                                        Reactivar
                                    </button>
                                </form>
                            {{/estadoInactiva}}

                            {{#estadoReportada}}
                                <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                Revisar
                                </a>
                            {{/estadoReportada}}

                            {{#estadoRechazada}}
                                <a href="editor/editar?id={{id}}" class="btn-action btn-edit">
                                Revisar
                                </a>

                                <form action="editor/recuperarRechazada" method="POST" style="display:inline;">
                                    <input type="hidden" name="id_pregunta" value="{{id}}">
                                    <button type="submit" class="btn-reactivar">
                                        Aprobar y reactivar
                                    </button>
                                </form>
                            {{/estadoRechazada}}

                        </div>
                    </td>
                </tr>
            {{/activas}}
            </tbody>
        </table>

        <div class="paginacion">

            {{#hayAnterior}}
                <a href="editor?pagina={{paginaAnterior}}"
                class="btn-pagina">
                Anterior
                </a>
            {{/hayAnterior}}

            <span>
        Página {{paginaActual}} de {{totalPaginas}}
    </span>

            {{#haySiguiente}}
                <a href="editor?pagina={{paginaSiguiente}}"
                class="btn-pagina">
                Siguiente
                </a>
            {{/haySiguiente}}

        </div>

    </div>

</div>