<style>
    * {
        box-sizing: border-box;
    }

    .editor-container {
        width: 92%;
        max-width: 1100px;
        margin: 30px auto 50px;
        padding: 35px 30px;
        background: rgba(7, 20, 42, 0.94);
        border: 1px solid #3B82F6;
        border-radius: 18px;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.45);
        color: #DCE6F8;
        font-family: Arial, Helvetica, sans-serif;
    }

    .editor-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(59, 130, 246, 0.35);
    }

    .editor-title {
        color: #60A5FA;
        font-size: 26px;
        font-weight: 700;
        margin: 0;
    }

    .btn-gold {
        padding: 8px 16px;
        border: 1px solid #F5D78A;
        border-radius: 8px;
        background: linear-gradient(110deg, #F4D47D, #C99A3D);
        color: #0A1A33;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
    }

    .btn-gold:hover {
        filter: brightness(1.1);
        transform: translateY(-1px);
    }

    .section-card {
        background: rgba(16, 39, 73, 0.45);
        border: 1px solid #315B91;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .section-title {
        color: #F1CD73;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    th {
        background: rgba(16, 39, 73, 0.95);
        color: #60A5FA;
        padding: 12px;
        text-align: left;
        border-bottom: 1px solid #315B91;
    }

    td {
        padding: 12px;
        border-bottom: 1px solid rgba(49, 91, 145, 0.35);
    }

    .btn-action {
        padding: 6px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s ease;
    }

    .btn-approve {
        background: #16A34A;
        color: white;
    }

    .btn-approve:hover {
        background: #15803d;
    }

    .btn-reject {
        background: #DC2626;
        color: white;
    }

    .btn-reject:hover {
        background: #b91c1c;
    }

    .btn-edit {
        background: #2563EB;
        color: white;
    }

    .btn-edit:hover {
        background: #1d4ed8;
    }

    .form-group {
        margin-bottom: 14px;
    }

    .editor-container label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        color: #93C5FD;
        margin-bottom: 6px;
    }

    .editor-container input[type="text"],
    .editor-container select {
        width: 100%;
        padding: 10px;
        background: rgba(10, 26, 51, 0.85);
        border: 1px solid #315B91;
        border-radius: 6px;
        color: #FFF;
        font-size: 13px;
    }

    .editor-container select option {
        background: #0A1A33;
        color: white;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 8px;
    }

    .option-row input[type="radio"] {
        accent-color: #F1CD73;
        width: 16px;
        height: 16px;
        flex-shrink: 0;
    }

    .option-row input[type="text"] {
        flex: 1;
    }

    .form-help {
        color: #88A5CD;
        font-size: 11px;
        margin-top: 5px;
    }

    @media (max-width: 700px) {
        .editor-container {
            width: 96%;
            padding: 20px 14px;
        }

        .editor-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .section-card {
            padding: 14px;
            overflow-x: auto;
        }

        table {
            min-width: 600px;
        }
    }
</style>

<div class="editor-container">

    <div class="editor-header">
        <div>
            <h1 class="editor-title">PANEL DE EDICIÓN</h1>
            <span style="font-size: 12px; color: #93C5FD;">
                Sesión iniciada como: {{username}}
            </span>
        </div>

        <a href="lobby" class="btn-gold">
            ← VOLVER AL LOBBY
        </a>
    </div>

    <!-- 1. REPORTES DE PREGUNTAS -->
    <div class="section-card">
        <div class="section-title">REPORTES DE PREGUNTAS</div>

        <table>
            <thead>
                <tr>
                    <th style="width: 45%;">Pregunta Reportada</th>
                    <th>Motivo</th>
                    <th>Comentario</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                {{#reportes_pendientes}}
                <tr>
                    <td>
                        <strong>{{pregunta_descripcion}}</strong>
                        {{#categoria}}
                            <br>
                            <small style="color: #93C5FD;">{{categoria}}</small>
                        {{/categoria}}
                    </td>

                    <td style="color: #FBBF24;">{{motivo}}</td>
                    <td>{{comentario}}</td>

                    <td style="text-align: center; white-space: nowrap;">
                        <a href="editor/editar?id={{pregunta_id}}"
                           class="btn-action btn-edit">
                            Corregir
                        </a>

                        <form action="editor/resolverReporte"
                              method="POST"
                              style="display:inline; margin-left: 5px;">

                            <input type="hidden" name="id_reporte" value="{{reporte_id}}">
                            <input type="hidden" name="accion" value="resuelto">

                            <button type="submit" class="btn-action btn-approve">
                                Resolver
                            </button>
                        </form>
                    </td>
                </tr>
                {{/reportes_pendientes}}

                {{^reportes_pendientes}}
                <tr>
                    <td colspan="4" style="text-align: center; color: #88A5CD; padding: 16px;">
                        No hay reportes de preguntas pendientes.
                    </td>
                </tr>
                {{/reportes_pendientes}}
            </tbody>
        </table>
    </div>

    <!-- 2. PREGUNTAS PENDIENTES -->
    <div class="section-card">
        <div class="section-title">
            REVISAR PREGUNTAS NUEVAS (SUGERIDAS)
        </div>

        <table>
            <thead>
                <tr>
                    <th>Pregunta</th>
                    <th>Categoría</th>
                    <th>Creador</th>
                    <th style="text-align: center;">Acciones</th>
                </tr>
            </thead>

            <tbody>
                {{#pendientes}}
                <tr>
                    <td>{{descripcion}}</td>
                    <td>{{categoria}}</td>
                    <td>{{creador}}</td>

                    <td style="text-align: center;">
                        <form action="editor/aprobar"
                              method="POST"
                              style="display:inline;">

                            <input type="hidden" name="id" value="{{id}}">

                            <button type="submit" class="btn-action btn-approve">
                                Aprobar
                            </button>
                        </form>

                        <form action="editor/rechazar"
                              method="POST"
                              style="display:inline; margin-left: 5px;">

                            <input type="hidden" name="id" value="{{id}}">

                            <button type="submit" class="btn-action btn-reject">
                                Rechazar
                            </button>
                        </form>
                    </td>
                </tr>
                {{/pendientes}}

                {{^pendientes}}
                <tr>
                    <td colspan="4" style="text-align: center; color: #88A5CD; padding: 16px;">
                        No hay preguntas pendientes de revisión.
                    </td>
                </tr>
                {{/pendientes}}
            </tbody>
        </table>
    </div>

    <!-- 3. AGREGAR NUEVA PREGUNTA -->
    <div class="section-card">
        <div class="section-title">AGREGAR NUEVA PREGUNTA</div>

        <form action="editor/guardar" method="POST">

            <div class="form-group">
                <label for="descripcion">Enunciado de la pregunta:</label>

                <input
                    type="text"
                    id="descripcion"
                    name="descripcion"
                    placeholder="Ej: ¿Quién es el capitán de la tripulación de Sombrero de Paja?"
                    maxlength="500"
                    required
                >
            </div>

            <div class="form-group">
                <label for="anime_id">Anime:</label>

                <select name="anime_id" id="anime_id" required>
                    <option value="">Seleccionar anime</option>

                    {{#animes}}
                    <option value="{{id}}">{{nombre}}</option>
                    {{/animes}}
                </select>
            </div>

            <div class="form-group">
                <label for="categoria_id">Categoría:</label>

                <select name="categoria_id" id="categoria_id" required>
                    <option value="">Seleccionar categoría</option>

                    {{#categorias}}
                    <option value="{{id}}">{{nombre}}</option>
                    {{/categorias}}
                </select>
            </div>

            <div class="form-group">
                <label for="dificultad">Dificultad:</label>

                <select name="dificultad" id="dificultad" required>
                    <option value="">Seleccionar dificultad</option>
                    <option value="facil">Fácil</option>
                    <option value="media">Media</option>
                    <option value="dificil">Difícil</option>
                </select>
            </div>

            <label style="margin-top: 15px;">
                Opciones de respuesta (Marcá la opción correcta):
            </label>

            <div class="option-row">
                <input type="radio" name="correcta" value="0" checked>
                <input type="text" name="opciones[]" placeholder="Opción A" maxlength="255" required>
            </div>

            <div class="option-row">
                <input type="radio" name="correcta" value="1">
                <input type="text" name="opciones[]" placeholder="Opción B" maxlength="255" required>
            </div>

            <div class="option-row">
                <input type="radio" name="correcta" value="2">
                <input type="text" name="opciones[]" placeholder="Opción C" maxlength="255" required>
            </div>

            <div class="option-row">
                <input type="radio" name="correcta" value="3">
                <input type="text" name="opciones[]" placeholder="Opción D" maxlength="255" required>
            </div>

            <p class="form-help">
                La pregunta se guardará como pendiente hasta que un editor o administrador la apruebe.
            </p>

            <button type="submit"
                    class="btn-action btn-approve"
                    style="margin-top: 12px; padding: 10px 20px; font-size: 13px;">
                Guardar Pregunta
            </button>

        </form>
    </div>

    <!-- 4. EDITAR PREGUNTAS ACTIVAS -->
    <div class="section-card">
        <div class="section-title">EDITAR PREGUNTAS ACTIVAS</div>

        <table>
            <thead>
                <tr>
                    <th style="width: 60%;">Pregunta</th>
                    <th>Categoría</th>
                    <th style="text-align: center;">Acción</th>
                </tr>
            </thead>

            <tbody>
                {{#activas}}
                <tr>
                    <td>{{descripcion}}</td>
                    <td>{{categoria}}</td>

                    <td style="text-align: center;">
                        <a href="editor/editar?id={{id}}"
                           class="btn-action btn-edit">
                            Editar
                        </a>
                    </td>
                </tr>
                {{/activas}}

                {{^activas}}
                <tr>
                    <td colspan="3" style="text-align: center; color: #88A5CD; padding: 16px;">
                        No hay preguntas activas registradas para editar.
                    </td>
                </tr>
                {{/activas}}
            </tbody>
        </table>
    </div>

</div>