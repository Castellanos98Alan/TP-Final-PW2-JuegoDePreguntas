                SET puntaje = :puntaje, 
                    resultado = :resultado 
                WHERE id = :idPartida
[00:36:24] [INFO] SELECT u.nombre_completo,
            u.username,
            u.foto_perfil,
            u.pais,
            u.ciudad,
            u.id_rol,
            COALESCE((SELECT SUM(p.puntaje)
                      FROM partida p
                      WHERE p.id_usuario = u.id
                        AND MONTH(p.created_at) = MONTH(CURRENT_DATE())
                        AND YEAR(p.created_at) = YEAR(CURRENT_DATE())), 0) AS puntaje_acumulado,
            COALESCE((SELECT SUM(p.puntaje)
