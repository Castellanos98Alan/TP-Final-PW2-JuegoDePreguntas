                        END AS porcentaje_aciertos
                    FROM pregunta p
                    LEFT JOIN categoria c ON p.categoria_id = c.id
                    LEFT JOIN anime a ON p.anime_id = a.id
                    LEFT JOIN historial_respuesta hr ON p.id = hr.pregunta_id AND YEAR(hr.fecha_respuesta) = YEAR(CURDATE())
                        AND MONTH(hr.fecha_respuesta) = MONTH(CURDATE())
                    WHERE p.esta_activa = 1
                    GROUP BY p.id, p.enunciado, a.id, a.nombre, c.id, c.nombre, p.dificultad
                ) t
                
