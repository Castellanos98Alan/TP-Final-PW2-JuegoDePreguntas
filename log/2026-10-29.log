[20:18:29] [INFO] SELECT
                    p.id,
                    p.enunciado,
                    p.respuesta_a,
                    p.respuesta_b,
                    p.respuesta_c,
                    p.respuesta_d,
                    p.tipo_pregunta,
                    p.recurso,
                    p.dificultad,
                    a.nombre AS anime,
                    c.nombre AS categoria

                FROM pregunta p

                JOIN anime a
                    ON p.anime_id = a.id
                JOIN categoria c
                    ON p.categoria_id = c.id

                LEFT JOIN usuario_pregunta up
                    ON p.id = up.pregunta_id
                    AND up.usuario_id = :usuarioId

                WHERE p.dificultad = :dificultad

                AND p.anime_id = :animeId

                AND p.esta_activa = 1

                AND up.pregunta_id IS NULL

                ORDER BY RAND()

                LIMIT 5
