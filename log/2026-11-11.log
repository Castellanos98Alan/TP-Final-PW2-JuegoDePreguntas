[02:15:43] [INFO] SELECT COUNT(*) + 1 AS posicion
            FROM (
                SELECT u.username, COALESCE(SUM(p.puntaje), 0) AS total
                FROM usuario u
                LEFT JOIN partida p ON u.id = p.id_usuario
                WHERE u.id_rol = 1 AND u.esta_activo = 1
                GROUP BY u.id, u.username
            ) r
            CROSS JOIN (
                SELECT u.username, COALESCE(SUM(p.puntaje), 0) AS total
                FROM usuario u
                LEFT JOIN partida p ON u.id = p.id_usuario
                WHERE u.id = :id
                GROUP BY u.id, u.username
            ) yo
            WHERE r.total > yo.total
               OR (r.total = yo.total AND r.username < yo.username)
[02:15:46] [INFO] SELECT u.id,
                       u.username,
                       u.nombre_completo,
                       u.foto_perfil,
                       u.pais,
                       u.ciudad,
                       u.puntaje_acumulado,
                       (SELECT COUNT(*) + 1
                        FROM usuario r
                        WHERE r.esta_activo = 1
                        AND r.id_rol = 1
                        AND r.puntaje_acumulado > u.puntaje_acumulado) AS posicion
                FROM usuario u
                WHERE u.esta_activo = 1
                AND u.id_rol = 1
                ORDER BY u.username ASC
