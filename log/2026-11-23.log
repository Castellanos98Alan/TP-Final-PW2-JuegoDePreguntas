[00:35:07] [INFO] SELECT t.*
                FROM (
                    SELECT
                        p.id,
                        p.enunciado AS descripcion,
                        a.id AS anime_id,
                        a.nombre AS anime,
                        c.id AS categoria_id,
                        c.nombre AS categoria,
                        CASE
                            WHEN (SELECT COUNT(*) FROM historial_respuesta hr_tot WHERE hr_tot.pregunta_id = p.id) < 0 THEN 'media'
                            ELSE COALESCE(p.dificultad, 'media')
                        END AS dificultad,
                        COUNT(hr.id) AS veces_mostrada,
                        COALESCE(SUM(hr.fue_correcta), 0) AS veces_acertada,
                        CASE
                            WHEN COUNT(hr.id) = 0 THEN 0
                            ELSE ROUND((SUM(hr.fue_correcta) / COUNT(hr.id)) * 100, 2)
                        END AS porcentaje_aciertos
                    FROM pregunta p
                    LEFT JOIN categoria c ON p.categoria_id = c.id
                    LEFT JOIN anime a ON p.anime_id = a.id
                    LEFT JOIN historial_respuesta hr ON p.id = hr.pregunta_id AND YEAR(hr.fecha_respuesta) = YEAR(CURDATE())
                        AND MONTH(hr.fecha_respuesta) = MONTH(CURDATE())
                    WHERE p.esta_activa = 1
                    GROUP BY p.id, p.enunciado, a.id, a.nombre, c.id, c.nombre, p.dificultad
                ) t
                
                ORDER BY t.id DESC
