[00:18:15] [INFO] SELECT
                    CASE
                        WHEN YEAR(CURDATE()) - u.anio_nacimiento < 18
                            THEN 'Menores de 18'
                        WHEN YEAR(CURDATE()) - u.anio_nacimiento BETWEEN 18 AND 25
                            THEN '18 a 25'
                        WHEN YEAR(CURDATE()) - u.anio_nacimiento BETWEEN 26 AND 35
                            THEN '26 a 35'
                        WHEN YEAR(CURDATE()) - u.anio_nacimiento BETWEEN 36 AND 50
                            THEN '36 a 50'
                        ELSE 'Mayores de 50'
                    END AS etiqueta,
                    COUNT(*) AS cantidad
                FROM usuario u
                WHERE u.id_rol = 1 AND YEAR(u.created_at) = YEAR(CURDATE())
                        AND MONTH(u.created_at) = MONTH(CURDATE())
                GROUP BY etiqueta
