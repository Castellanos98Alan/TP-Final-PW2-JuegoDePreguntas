            FROM historial_respuesta
            WHERE usuario_id = :usuarioId
[03:09:02] [INFO] SELECT
                p.id,
                p.enunciado,
                p.respuesta_a,
                p.respuesta_b,
                p.respuesta_c,
                p.respuesta_d,
                p.tipo_pregunta,
                p.recurso,
                p.dificultad,
                a.nombre AS anime,
                c.nombre AS categoria

            FROM pregunta p

            JOIN anime a
                ON p.anime_id = a.id

            JOIN categoria c
                ON p.categoria_id = c.id

            LEFT JOIN usuario_pregunta up
                ON p.id = up.pregunta_id
                AND up.usuario_id = :usuarioId

            WHERE p.esta_activa = 1

            AND p.anime_id IN (:anime0)
    AND up.pregunta_id IS NULL

    ORDER BY
        CASE
            WHEN p.dificultad = :dificultad
            THEN 0
            ELSE 1
        END,
        RAND()

    LIMIT 1
