        SELECT
            p.id,
            p.enunciado,
            p.respuesta_a,
            p.respuesta_b,
            p.respuesta_c,
            p.respuesta_d,
            p.tipo_pregunta,
            p.recurso,
            p.dificultad,
            a.nombre AS anime,
            c.nombre AS categoria

        FROM pregunta p

        INNER JOIN anime a
            ON p.anime_id = a.id

        INNER JOIN categoria c
            ON p.categoria_id = c.id AND c.esta_activa = 1

        LEFT JOIN usuario_pregunta up
            ON p.id = up.pregunta_id
            AND up.usuario_id = :usuarioId

        WHERE p.esta_activa = 1

        AND p.anime_id IN (:anime0)

        AND c.id = :categoriaId

        
    
        AND up.pregunta_id IS NULL

        ORDER BY
            CASE
                WHEN p.dificultad = :dificultad THEN 0
                ELSE 1
            END,
            RAND()

        LIMIT 1
    
